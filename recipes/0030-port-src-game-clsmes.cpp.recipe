+// Jep (co-op), coop: netplay: the tables only shape how a message window is drawn (its bubble's wobble), but retail rolls
+// them from the game's generator, which a linked pair keeps alike. A window rebuilds only when its text changes
+// (ClsMes::MakeMesWin's mes_made), and that is per copy: a host that used the Georama before player 2 joined had its
+// part-name window made, the joiner's never was, so the next Georama menu rebuilt it on one copy only, 64 rolls apart
+// (Jep, 2026-10-20: the resync back to the town's entrance). While linked they roll from a generator of their own instead.
+// DC_NETPLAY_MUTATE=shared_table_rand rolls them from the game's (twin).
+namespace {
+int TableRand() {
+    static unsigned int state = 0x2545F491u;
+
+    if (NetplayLocalPlayer() == 0 || NetplayMutated("shared_table_rand")) {
+        return std::rand();
+    }
+
+    state = state * 1103515245u + 12345u;
+    return static_cast<int>(state & 0x7FFFFFFFu);
+}
+} // namespace
+

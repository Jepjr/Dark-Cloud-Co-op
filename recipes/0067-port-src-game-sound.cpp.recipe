+// Jep (co-op): audio
+// What coop_audio.cpp plays through the mixer for this copy alone. None of it touches the game's
+// sound state (midi_state, the tables, the volumes the game reads back).
+
+void SoundCoopMusicVolume(int port, int volume) {
+    if (port < 0 || port >= audio::kPorts || g_volume_override[port] == volume) {
+        return;
+    }
+    g_volume_override[port] = volume;
+    Player().SetVolume(port, PlayedVolume(port));
+}
+
+void SoundCoopMusicScale(int port, float scale) {
+    if (port < 0 || port >= audio::kPorts || g_volume_scale[port] == scale) {
+        return;
+    }
+    g_volume_scale[port] = scale;
+    Player().SetVolume(port, PlayedVolume(port));
+}
+
+bool SoundCoopPlaying(int port) {
+    return port >= 0 && port < audio::kPorts && Player().IsPlaying(port);
+}
+
+int SoundCoopPlayedVolume(int port) {
+    return port >= 0 && port < audio::kPorts ? Player().Volume(port) : -1;
+}
+

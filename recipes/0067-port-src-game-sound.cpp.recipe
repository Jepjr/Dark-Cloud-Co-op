+} // namespace
+
+bool SoundCoopLoadVoice(int set_no) {
+    char path[64];
+    char list_name[32];
+    std::snprintf(path, sizeof(path), "sound/voice/voice%d.snd", set_no);
+    std::snprintf(list_name, sizeof(list_name), "voice%d.txt", set_no);
+
+    static std::vector<unsigned int> pack(256 * 1024 / 4, 0u);
+    auto                             bank = LoadCoopBank(path, list_name, 0, kCoopVoicePort, pack);
+    if (bank == nullptr) {
+        return false;
+    }
+    g_partner_voice = bank;
+    return true;
+}
+
+bool SoundCoopLoadSpecial(int set_no) {
+    if (g_partner_special != nullptr && g_partner_special_set == set_no) {
+        return true;
+    }
+    char path[64];
+    char list_name[32];
+    std::snprintf(path, sizeof(path), "sound/special/sp%d.snd", set_no);
+    std::snprintf(list_name, sizeof(list_name), "sp%d.txt", set_no);
+
+    // (Its own buffer: the voice bank's data stays in the voice one.)
+    static std::vector<unsigned int> pack(256 * 1024 / 4, 0u);
+    g_partner_special = nullptr;
+    g_partner_special_set = -1;
+    auto bank = LoadCoopBank(path, list_name, 'q', kCoopSpecialPort, pack);
+    if (bank == nullptr) {
+        return false;
+    }
+    g_partner_special = bank;
+    g_partner_special_set = set_no;
+    return true;
+}
+
+bool SoundCoopSpecial(int bank, int program, int volume) {
+    if (g_partner_special == nullptr) {
+        return false;
+    }
+    // As SndSPSePlay's, centred, queued with the game's effects.
+    g_effect_queue.push_back({kCoopSpecialPort, false, static_cast<std::uint32_t>(((bank & 0x7F) << 8) | 0xC0), {}});
+    g_effect_queue.push_back({kCoopSpecialPort, true, 0, {0xF9, 0, 0, static_cast<std::uint8_t>(volume), 0}});
+    g_effect_queue.push_back({kCoopSpecialPort, true, 0, {0xF9, 1, 0, 0x40, 0}});
+    g_effect_queue.push_back({kCoopSpecialPort, true, 0, {0xFD, 0x10, 0, static_cast<std::uint8_t>(program), 0, 0x7F, 0}});
+    return true;
+}
+
+int SoundCoopEffectVolume(int se_no) {
+    return se_no >= 0 && se_no < se_inf_tbl.count ? se_inf_tbl.entry[se_no].volume : -1;
+}
+
+void SoundCoopVoice(int bank, int program, int pan, int volume) {
+    if (g_partner_voice == nullptr) {
+        return;
+    }
+    // Queued with the game's effects, so it sounds on the same Step as they do.
+    g_effect_queue.push_back({kCoopVoicePort, false, static_cast<std::uint32_t>(((bank & 0x7F) << 8) | 0xC0), {}});
+    g_effect_queue.push_back({kCoopVoicePort, true, 0, {0xF9, 0, 0, static_cast<std::uint8_t>(volume), 0}});
+    g_effect_queue.push_back({kCoopVoicePort, true, 0, {0xF9, 1, 0, static_cast<std::uint8_t>(pan), 0}});
+    g_effect_queue.push_back({kCoopVoicePort, true, 0, {0xFD, 0x10, 0, static_cast<std::uint8_t>(program), 0, 0x7F, 0}});
+}

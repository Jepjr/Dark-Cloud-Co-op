+// The partner's voice set, bound to a port of its own that nothing of the game's plays on.
+std::shared_ptr<audio::Bank> g_partner_voice;
+// coop-atlaopen: player 2's special set (sound/special/spN.snd: her chest's and Atla's presentation sounds), on a port of
+// its own too, so the game's special set (MIDI_PORT_SE_SPECIAL, player 1's presentations) is never swapped under him.
+std::shared_ptr<audio::Bank> g_partner_special;
+int                          g_partner_special_set = -1;
+
+// The first bank (kind 0: any; else that slot letter) of a sound pack (path), as its list (list_name) names them, bound to
+// port; nullptr when there is none. pack is the caller's buffer: the bank's data stays in it.
+std::shared_ptr<audio::Bank> LoadCoopBank(const char *path, const char *list_name, char kind, int port,
+                                          std::vector<unsigned int> &pack) {
+    const std::uintmax_t size = data::DataFileSize(path);
+    if (size == 0) {
+        std::printf("coop-audio: no %s\n", path);
+        return nullptr;
+    }
+    // LoadFile2 zeroes the rest of the file's last 2048-byte sector, and the localizer notes the
+    // buffer as a pack's, so the buffer is whole sectors and stays where it is: one of 256 KiB (the
+    // voice sets are at most 130 KB, the special sets 121 KB).
+    if ((size + 2047) / 2048 * 2048 > pack.size() * 4) {
+        std::printf("coop-audio: %s is too big (%ju bytes)\n", path, size);
+        return nullptr;
+    }
+    int read = 0;
+    if (!LoadFile2(const_cast<char *>(path), pack.data(), &read, 0)) {
+        return nullptr;
+    }
+
+    int         list_size = 0;
+    const char *list = reinterpret_cast<const char *>(GetPackFile(pack.data(), const_cast<char *>(list_name), &list_size));
+    if (list == nullptr) {
+        std::printf("coop-audio: %s not in %s\n", list_name, path);
+        return nullptr;
+    }
+    const std::string text(list, strnlen(list, list_size));

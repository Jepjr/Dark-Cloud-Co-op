+// Jep (co-op): five rows from 284 would reach 413, into the trademark lines. They start at 274, where
+// co-op's four painted rows started (clear of the logo on every PC it was played on), 26 apart: the
+// last row's capitals end at 395, their halo at 398, and each row keeps 9 clear between its letters
+// and the next row's. The screen is 640x480 logical units at every aspect and interface size, so the
+// rows stand the same on all of them.
+constexpr int kFiveFirstTextTop = 274;
+constexpr int kFiveRowStride = 26;
+
@@ -118,0 +133,23
+// The table's entry shown on a row: without the Multi-player row, OPTION and EXIT move up one.
+const Row &EntryAt(int row) {
+    row = std::clamp(row, 0, RowCount() - 1);
+    if (RowCount() < kMaxRows && row >= kMultiplayerEntry) {
+        ++row;
+    }
+    return kRows[row];
+}
+
+// Jep (co-op): whether the rows take the five rows' places. DC_TITLE_MP_MUTATE=old_pitch (mp-title-row's
+// twin): five rows on the four rows' places, the last one in the trademark lines.
+bool FivePlaces() {
+    return RowCount() == kMaxRows && !TestEnvIs("DC_TITLE_MP_MUTATE", "old_pitch");
+}
+
+int FirstTop() {
+    return FivePlaces() ? kFiveFirstTextTop : kFirstTextTop;
+}
+
+int Stride() {
+    return FivePlaces() ? kFiveRowStride : kRowStride;
+}
+
@@ -120,0 +158,31
+int RowCount() {
+    // Jep (co-op): DC_TITLE_MP_MUTATE=no_menu_row (mp-title-row's twin): the menu without the Multi-player row, as the
+    // repin's BANDAID left it.
+    return TitleMpShown() && !TestEnvIs("DC_TITLE_MP_MUTATE", "no_menu_row") ? kMaxRows : kMaxRows - 1;
+}
+
+int RowOf(int select) {
+    for (int row = 0; row < RowCount(); ++row) {
+        if (EntryAt(row).select == select) {
+            return row;
+        }
+    }
+    return -1;
+}
+
+int SelectAt(int row) {
+    return EntryAt(row).select;
+}
+
+const char *RowEnglish(int row) {
+    return EntryAt(row).english;
+}
+
+int TextTop(int row) {
+    return FirstTop() + row * Stride();
+}
+
+float RowsBottom() {
+    return static_cast<float>(TextTop(RowCount() - 1)) + kCapHeight + kHaloReach;
+}
+

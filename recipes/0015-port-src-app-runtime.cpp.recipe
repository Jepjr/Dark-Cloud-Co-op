+
+// coop: cameras
+// Puts the state back: independent co-op cameras keep drawing's calls (CFireOmni's reseeding among
+// them), which differ with what each copy shows, out of the state the game steps with.
+void PortRandSetState(unsigned int state) {
+    if (RandTrace() && state != g_rand_state) {
+        std::fprintf(stderr, "rand set %08x\n", state);
+    }
+
+    g_rand_state = state;
+}
+
+} // namespace dc::game
+
+// DC_RAND_TRACE=1 (debugging a desync): every call's caller, as an offset from rand itself (the same in two copies
+// of one build), and every put-back of the state, on stderr; two copies' traces diff to the first call that differs.
+static bool RandTrace() {
+    static const bool on = std::getenv("DC_RAND_TRACE") != nullptr;
+
+    return on;
+}

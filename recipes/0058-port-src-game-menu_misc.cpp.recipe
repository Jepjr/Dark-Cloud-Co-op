+// Jep (co-op), coop-wepmenu: the weapons page's two files for a character, named once for StartReadWepMDS and its prefetch.
+std::string WepMdsPath(int chara) {
=584 6ef281e46574abf8
+    return std::format("commenu/c{}wtes.chr", numbers[chara]);
+}
+
+std::string WepImagePath(int chara) {
=585 d4004027eaedb555
+    std::array<char, 64>                      lang_dir{};
=599 badd0e85a8e55b20
+    return std::format("{}{}2.img", lang_dir.data(), names[chara]);

+
+} // namespace
+
+// Jep (co-op), coop-wepmenu: every character's weapons page files read on a thread of their own as a menu opens (data_read.cpp's
+// DataReadPrefetch), so the page's LoadFileBG of each copies bytes already read instead of opening the file on the game thread. On a
+// floor the page also reads the equipped weapon's effect (DngWepEffectReadStart; a cold one held the game thread 5.8 ms): each
+// character's (Ruby's every form) is read ahead, named by Get_Main_EffectPtr as the page names it; for Osmond it also writes his gun
+// type, which is put back at once, so the menu's opening changes nothing of the game.
+// DC_COOP_MUTATE=wepmenu_no_prefetch: none (the twin).
+void MenuWeaponPagePrefetch() {
+    if (!coop::WeaponPagePrefetchOn()) {
+        return;
+    }
+    std::vector<std::string> paths;
+    for (int chara = 0; chara < 6; chara++) {
+        paths.push_back(WepMdsPath(chara));
+        paths.push_back(WepImagePath(chara));
+    }
+    if (BtlMenuMode == BATTLE_MENU_MODE_DUNGEON && UserStatus != nullptr) {
+        const s32 gun_type = BtActStatus.gun_type;
+        for (int chara = 0; chara < 6; chara++) {
+            for (int form = 0; form < (chara == CHARA_RUBY ? 5 : 1); form++) {
+                if (const BT_SHOT_EFFECT *effect = Get_Main_EffectPtr(chara, form); effect != nullptr) {
+                    paths.push_back(WeaponEffectPath(effect));
+                }
+            }
+        }
+        BtActStatus.gun_type = gun_type;
+    }
+    dc::data::DataReadPrefetch(paths);
+}
+

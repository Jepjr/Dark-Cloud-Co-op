+// coop-saveload: the ring's choosers (save or load, quit) and the load under way, which coop_fullmenu keeps per menu
+// with the menu's other globals, so a menu open beside another neither steps nor draws the other's. The load's request
+// to the game loop (ingame_load_pending) stays one.
+void BattleMenuRingRegions(void (*add)(void *at, std::size_t size)) {
+    add(&quit_confirm_active, sizeof quit_confirm_active);
+    add(&quit_confirm_choice, sizeof quit_confirm_choice);
+    add(&quit_cursor, sizeof quit_cursor);
+    add(&saveload_modal_active, sizeof saveload_modal_active);
+    add(&saveload_modal_choice, sizeof saveload_modal_choice);
+    add(&saveload_cursor, sizeof saveload_cursor);
+    add(&ingame_load_active, sizeof ingame_load_active);
+}

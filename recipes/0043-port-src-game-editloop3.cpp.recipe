+void EdCloseTalkMes();
+} // namespace
+
+int EdTalkStateBytes() {
+    return static_cast<int>(sizeof(EdTalkSaved));
+}
+
+void EdTalkStateSwap(void *saved) {
+    auto *other = static_cast<EdTalkSaved *>(saved);
+
+    std::swap(other->villager, talk_villager__2);
+    std::swap(other->chara_info_id, talk_chara_info_id);

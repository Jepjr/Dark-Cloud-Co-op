+// coop-talks2: a second talk beside the room's own (player 2's, port/src/coop/coop_town.cpp): this file's talk statics and
+// EdEventInfo's talk fields, swapped with a saved set of them around her talk's start, step and draw. The talk's message
+// window (EditMes1) is swapped by its caller.
+namespace {
+struct EdTalkSaved {
+    CNPCharacter *villager;
+    int           chara_info_id;
+    int           camera;
+    TalkModeState mode;
+    int           select;
+    int           mes_make;
+    int           mes_no;

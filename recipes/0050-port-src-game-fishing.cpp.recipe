+bool CoopPondFishMine(int fish_no); // this fish's bite is at the running fisher's hook, or it is on their line
+bool CoopPondFishReset(int fish_no); // FishingInitFishStatus: this fish is the running fisher's to calm (on their line)
+void CoopPondOnLine(int fish_no);   // the running fisher hooked it (or holds it up): on their line till caught or gone
+void CoopPondRecord(float *hook, int food, float radius); // FishingStepFish: the running fisher's hook and bait this tick
+bool CoopPondSteps();               // FishingStepFish: the pond steps its own fish once a tick (true: not here)
+bool CoopPondDrawsFish();           // FishingDrawFish: the pond draws its own fish on every screen (true: not here)

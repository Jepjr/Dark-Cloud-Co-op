+// Jep (co-op, coop-pt1111e): DC_QUEST_TEST_SHOP=1 (x-talk-follow -Shop): the mayor offers a shop of his own (one bread at 7
+// gilda), a quest's shop for the co-op merge's tests (no quest of the game opens one yet).
+Definition TestShop() {
+    return Builder("test_shop")
+        .Stages({"open"})
+        .Option(NoruneMayor(), [](const Context &) { return true; }, {"quest.test_shop.ask", "Show me your wares"},
+                [](Scene &scene) {
+                    ShopSpec shop;
+                    shop.look_of_shop = 0;
+                    shop.goods.push_back({game::ITEM_BREAD, 7});
+                    shop.keeper = Shopkeeper::Retail;
+                    scene.OpenShop(std::move(shop));
+                })
+        .Build();
+}

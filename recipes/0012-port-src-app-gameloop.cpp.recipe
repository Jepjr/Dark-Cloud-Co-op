+// debug start: once, the floor a dungeon:<n>:<floor> jump enters (0 up), marked reached; -1 otherwise.
+int GameTakeJumpFloor() {
+    int floor = g_jump_floor;
+    g_jump_floor = -1;
+    // coop-snapshot: a floor-start checkpoint taken (netplay): straight onto the host's floor. His save, which this copy
+    // holds now, already has the floor reached and the party, so none of the debug start's seeding below.
+    if (floor < 0) {
+        const int netplay_floor = NetplayTakeRestartFloor();
+        if (netplay_floor >= 0) {
+            std::fprintf(stderr, "catchup: entering dungeon %d floor %d, the checkpoint's\n", selectMapNo, netplay_floor + 1);
+            return netplay_floor;
+        }
+    }
+    if (floor >= 0 && DebugStartMutated("floor")) {
+        floor = floor > 0 ? floor - 1 : floor + 1;
+    }
+    if (floor < 0) {
+        floor = DebugStartTakeResyncFloor(); // the floor the host was on before a join's resync
+    }
+    if (floor < 0 || UserStatus == nullptr) {
+        return -1;
+    }
+    // The story scenes a fresh save would play on arriving and that a test start skips, by the game flag each
+    // sets (a sweep of every floor, 2026-10-20): Divine Beast Cave's floors 1 (103), 2 (100), 3 (106), 5 (104),
+    // 6 (101) and 7 (105), Sun and Moon Temple's 4 (130) and 7 (131), Moon Sea's 8 (140). The bosses' scenes
+    // stay (Shipwreck's 18, 120, among them).
+    static const int scenes_seen[] = {100, 101, 103, 104, 105, 106, 130, 131, 140};
+    for (int flag : DebugStartMutated("scene") ? std::span<const int>() : std::span<const int>(scenes_seen)) {
+        SaveData->SetGameFlag(flag, 1);
+    }
+    // The party the story has by the end of this dungeon, each with its starting weapon, as joining gives it: a
+    // fresh party of Toan alone cannot load some floors, which call on the member who joins in that dungeon
+    // (Divine Beast Cave's 11th Xiao, Wise Owl Forest's 12th Goro, Shipwreck's 5th every member's weapon).
+    static const int party[7] = {2, 3, 4, 5, 6, 6, 6};
+    static const int starter[6] = {ITEM_WEAPON_DAGGER,    ITEM_WEAPON_WOODEN_SLINGSHOT, ITEM_WEAPON_MALLET,
+                                   ITEM_WEAPON_GOLD_RING, ITEM_WEAPON_FIGHTING_STICK,   ITEM_WEAPON_MACHINE_GUN};
+    // DC_DEBUG_START_MUTATE=party: the party as it is (a fresh save's Toan alone: v-standin-weapon's stand-in).
+    if (selectMapNo >= 0 && selectMapNo < 7 && UserStatus->party_size < party[selectMapNo] && !DebugStartMutated("party")) {
+        UserStatus->party_size = static_cast<s8>(party[selectMapNo]);
+        for (int i = 1; i < UserStatus->party_size; i++) {
+            if (UserStatus->equipped_weapon_slot[i] < 0) {
+                static_cast<CDngStatusData *>(UserStatus)->GetItem(starter[i], 0);
+                UserStatus->equipped_weapon_slot[i] = 0;
+            }
+        }
+    }
+    s8 &reached = UserStatus->floor_reached[selectMapNo];
+    reached = std::max<s8>(reached, static_cast<s8>(floor));
+    std::fprintf(stderr, "debug start: entering dungeon %d floor %d\n", selectMapNo, floor + 1);
+    return floor;
+}
+
+static int g_where_last[4] = {-2, -2, -2, -2}; // debug start: the place last printed
+
+// debug start: DC_DEBUG_START_TRACE=1 prints the place, each time it changes, for the tests (read only).
+void DebugStartTraceWhere() {
+    static const bool on = TestEnv("DC_DEBUG_START_TRACE") != nullptr;
+    int              (&last)[4] = g_where_last;
+    if (!on) {
+        return;
+    }
+    const bool dungeon = mode == GAME_MODE_DUNGEON;
+    const int  now[4] = {static_cast<int>(mode), static_cast<int>(MapNo),
+                         dungeon && UserStatus != nullptr ? UserStatus->cur_floor + 1 : 0,
+                         dungeon ? static_cast<int>(gameTask == GAME_TASK_PLAY) : 0};
+    // The dungeon's event flags (the floor scripts' first-visit scenes), each change.
+    static s8 flags[50] = {};
+    if (UserStatus != nullptr && dungeon) {
+        for (int i = 0; i < 50; i++) {
+            if (UserStatus->event_flags[i] != flags[i]) {
+                std::fprintf(stderr, "debug start: event flag %d %d -> %d at tick %lld\n", i, flags[i],
+                             UserStatus->event_flags[i], (long long) g_frames);
+                flags[i] = UserStatus->event_flags[i];
+            }
+        }
+    }
+    // The save's game flags (story progress; the event scripts' _SGET_GAME_FLAG), each change.
+    static std::vector<char> game(8192, 0);
+    for (int i = 0; i < 8192; i++) {
+        const char value = SaveData->GetGameFlag(i) != 0;
+        if (value != game[i]) {
+            std::fprintf(stderr, "debug start: game flag %d -> %d at tick %lld (mode %d)\n", i, value, (long long) g_frames,
+                         static_cast<int>(mode));
+            game[i] = value;
+        }
+    }
+    if (std::equal(now, now + 4, last)) {
+        return;
+    }
+    std::copy(now, now + 4, last);
+    std::fprintf(stderr, "debug start: where tick %lld mode %d map %d floor %d playing %d\n", (long long) g_frames, now[0],
+                 now[1], now[2], now[3]);
+}
+
+// debug start: the picker's choice, applied as a jump would have been at boot.
+void GameApplyDebugStart(int mode_, int map, int floor) {
+    // Debug mode on, as a --jump has it: it comes to a joiner with the host's state, and a join's resync then
+    // goes straight back onto the host's floor (debug_start.cpp).
+    DebugMode = 1;
+    g_jump.mode = mode_;
+    g_jump.map = map;
+    g_jump.floor = floor;
+    g_jump.pick = false;
+    g_jump.debug = true;
+    ApplyJump();
+    if (mode_ == GAME_MODE_EDIT && map >= 0 && map < 200) {
+        // A town as the game travels to one, by a map jump the main loop follows as the picker's mode ends, as a
+        // dungeon's is: a catch-up host's checkpoint then names where it goes (a town set straight into the mode
+        // instead replayed out of step on the joiner in Matataki and Muska Racka).
+        MapJump(map, -1);
+    }
+}

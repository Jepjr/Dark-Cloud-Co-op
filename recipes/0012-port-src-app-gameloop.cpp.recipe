+// debug start: the press of pad 1's L3+R3 (the lockstep's pad 1 when linked: the host's), outside the menu.
+bool GameDebugStartRequested() {
+    static bool   held_before = false;
+    InputPadState linked;
+    const bool    lockstep = !DebugStartMutated("local") && NetplayPad(0, linked);
+    const auto    buttons = lockstep ? linked.buttons : InputGetPad(0).buttons;
+    const bool    held = (buttons & (kInputL3 | kInputR3)) == (kInputL3 | kInputR3);
+    const bool    pressed = held && !held_before;
+    held_before = held;
+    return pressed && mode != GAME_MODE_MENU;
+}

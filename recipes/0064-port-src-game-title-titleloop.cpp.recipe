@@ -250,0 +264,27
+// coop: the rows the menu shows, said once for each layout (mp-title-row, c-solo-title): their order, their capitals'
+// tops and where the last one's letters end, against the trademark lines; and the frame the Multi-player row is first
+// drawn on, with the game's own rows (coop-mainmenu, Jep 2026-10-30: it showed a moment late).
+void SayTitleRows() {
+    static int  said_count = 0;
+    static int  frames = 0;
+    static bool said_multi = false;
+    const int   rows = title::menu::RowCount();
+
+    frames++;
+    if (rows != said_count) {
+        said_count = rows;
+        std::string names;
+        std::string tops;
+        for (int row = 0; row < rows; ++row) {
+            names += std::string(row != 0 ? " " : "") + title::menu::RowEnglish(row) + " " + std::to_string(row);
+            tops += " " + std::to_string(title::menu::TextTop(row));
+        }
+        std::fprintf(stderr, "title: rows %s; capitals' tops%s; the last row's letters end at %.1f, the trademark lines start at %d\n",
+                     names.c_str(), tops.c_str(), static_cast<double>(title::menu::RowsBottom()), title::menu::kTrademarkTop);
+    }
+    if (!said_multi && title::menu::RowOf(TITLE_MENU_MULTIPLAYER) >= 0) {
+        said_multi = true;
+        std::fprintf(stderr, "title-mp: Multi-player row shown above Option (one client), drawn on the menu's frame %d\n", frames);
+    }
+}
+

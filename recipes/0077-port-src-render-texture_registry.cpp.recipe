+bool PortMoveKeys(unsigned from_tbp, unsigned to_tbp, unsigned from_cbp, unsigned to_cbp) {
+    Entry *image = Live(from_tbp);
+    if (image == nullptr || image->kind != EntryKind::Image || !KeyUsable(to_tbp)) {
+        return false;
+    }
+    Entry *palette = from_cbp != 0 ? Live(from_cbp) : nullptr;
+    if (from_cbp != 0 && (palette == nullptr || palette->kind != EntryKind::Palette || !KeyUsable(to_cbp) || to_cbp == to_tbp)) {
+        return false;
+    }
+    if (to_tbp != from_tbp) {
+        Evict(to_tbp);
+        Reg().entries[to_tbp] = std::move(*image);
+        *image = Entry{};
+    }
+    if (palette != nullptr && to_cbp != from_cbp) {
+        Evict(to_cbp);
+        Reg().entries[to_cbp] = std::move(*palette);
+        *palette = Entry{};
+    }
+    if (palette != nullptr) {
+        Reg().entries[to_tbp].palette = to_cbp;
+    }
+    return true;
+}
+
+// coop-pt1108f (Jep's 11-09 playtest, a real join between two PCs: P2's menu and name boxes without their pictures): the moves of
+// a state set's rebuild, all at once. One at a time, a move evicted what sat at its target: on a joiner whose keys differ from the
+// host's (a headless pair's never do), that could be a sheet still waiting for its own move, which then became a blank placeholder.
+bool PortCanMoveKeys(unsigned from_tbp, unsigned to_tbp, unsigned from_cbp, unsigned to_cbp) {
+    const Entry *image = Live(from_tbp);
+    if (image == nullptr || image->kind != EntryKind::Image || !KeyUsable(to_tbp)) {
+        return false;
+    }
+    if (from_cbp != 0) {
+        const Entry *palette = Live(from_cbp);
+        return palette != nullptr && palette->kind == EntryKind::Palette && KeyUsable(to_cbp) && to_cbp != to_tbp;
+    }
+    return true;
+}
+
+void PortMoveKeysTogether(const std::vector<PortKeyMove> &moves) {
+    struct Lifted {
+        Entry image, palette;
+    };
+    std::vector<Lifted> lifted(moves.size());
+    for (std::size_t i = 0; i < moves.size(); i++) {
+        lifted[i].image = std::move(Reg().entries[moves[i].from_tbp]);
+        Reg().entries[moves[i].from_tbp] = Entry{};
+        if (moves[i].from_cbp != 0) {
+            lifted[i].palette = std::move(Reg().entries[moves[i].from_cbp]);
+            Reg().entries[moves[i].from_cbp] = Entry{};
+        }
+    }
+    for (std::size_t i = 0; i < moves.size(); i++) {
+        Evict(moves[i].to_tbp);
+        Reg().entries[moves[i].to_tbp] = std::move(lifted[i].image);
+        if (moves[i].from_cbp != 0) {
+            Evict(moves[i].to_cbp);
+            Reg().entries[moves[i].to_cbp] = std::move(lifted[i].palette);
+            Reg().entries[moves[i].to_tbp].palette = moves[i].to_cbp;
+        }
+    }
+}
+
+unsigned long PortTextureMisses() {
+    return g_misses;
+}

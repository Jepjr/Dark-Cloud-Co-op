+bool PortCreateTextureAt(unsigned tbp, unsigned cbp, const PortDecodedTexture &decoded, PortTextureOwner owner) {
+    const bool indexed = decoded.format == gfx::TextureFormat::Index8;
+    if (!KeyUsable(tbp) || decoded.levels.empty() || (indexed && (!KeyUsable(cbp) || cbp == tbp))) {
+        return false;
+    }
+    Evict(tbp);
+    FillImage(Reg().entries[tbp], decoded, owner);
+    if (indexed) {
+        Evict(cbp);
+        FillPalette(Reg().entries[cbp], decoded.palette, decoded.four_bit, owner);
+        Reg().entries[tbp].palette = cbp;
+    }
+    return true;
+}

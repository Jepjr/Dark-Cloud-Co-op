@@ -1332,0 +1334,34
+// Jep (co-op): InputSetPadsMerged.
+bool g_pads_merged = false;
+
+void InputSetPadsMerged(bool on) { g_pads_merged = on; }
+
+bool InputPadsMerged() { return g_pads_merged; }
+
+namespace {
+
+int Push(std::uint8_t x, std::uint8_t y) {
+    return std::max(std::abs(int(x) - int(kInputAxisCentre)), std::abs(int(y) - int(kInputAxisCentre)));
+}
+
+// Jep (co-op): pad 0's view with the other open controllers added (InputSetPadsMerged).
+void MergeOtherPads(InputPadState &view) {
+    for (int other = 1; other < kInputPadCount; ++other) {
+        if (g_slots[other].gamepad == nullptr || g_override[other]) {
+            continue;
+        }
+        const InputPadState &pad = g_device[other];
+        view.buttons |= pad.buttons;
+        if (Push(pad.left_x, pad.left_y) > Push(view.left_x, view.left_y)) {
+            view.left_x = view.look_left_x = pad.left_x;
+            view.left_y = view.look_left_y = pad.left_y;
+        }
+        if (Push(pad.right_x, pad.right_y) > Push(view.right_x, view.right_y)) {
+            view.right_x = pad.right_x;
+            view.right_y = pad.right_y;
+        }
+    }
+}
+
+} // namespace
+

+    s.snap_cursor = g_state.snap_cursor;
+    s.blink_counter = g_state.blink_counter;
+    return s;
+}
+
+void SwapLive(KeptSession &s) {
+    std::swap(s.active, g_state.active);
+    std::swap(s.last_end, g_state.last_end);
+    std::swap(s.active_ctx, g_state.active_ctx);
+    std::swap(s.original_message, g_state.original_message);
+    std::swap(s.stack, g_state.stack);
+    std::swap(s.cached_view, g_state.cached_view);
+    std::swap(s.snap_cursor, g_state.snap_cursor);
+    std::swap(s.blink_counter, g_state.blink_counter);
+    ++g_state.view_generation; // (the default renderer lays the labels out again)
+}

+std::array<KeptSession, kSessionSlots> g_kept;
+std::vector<ChoiceResolverFn>          g_resolvers;
+
+bool BindChoice(const NpcContext &ctx, ChoiceItem &item) {
+    if (item.id == "builtin.talk") {
+        item.on_select = [](ISessionController &ctrl) { ctrl.PlayOriginalMessage(); };
+        return true;
+    }
+    if (item.id == "builtin.leave") {
+        item.on_select = [](ISessionController &ctrl) { ctrl.Close(); };
+        return true;
+    }
+    for (const ChoiceResolverFn &resolve : g_resolvers) {
+        if (resolve(ctx, item)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+class Writer {
+public:
+    explicit Writer(std::vector<uint8_t> &out) : out_(out) {}
+    void U32(uint32_t value) {
+        for (int i = 0; i < 4; i++) {
+            out_.push_back(static_cast<uint8_t>(value >> (8 * i)));
+        }
+    }
+    void I32(int32_t value) { U32(static_cast<uint32_t>(value)); }
+    void F32(float value) {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, 4);
+        U32(bits);
+    }
+    void Str(const std::string &text) {
+        U32(static_cast<uint32_t>(text.size()));
+        out_.insert(out_.end(), text.begin(), text.end());
+    }
+    void Strs(const std::vector<std::string> &texts) {
+        U32(static_cast<uint32_t>(texts.size()));
+        for (const std::string &text : texts) {
+            Str(text);
+        }
+    }
+
+private:
+    std::vector<uint8_t> &out_;
+};
+
+class Reader {
+public:
+    Reader(const uint8_t *data, size_t size) : data_(data), size_(size) {}
+    bool     Ok() const { return ok_; }
+    uint32_t U32() {
+        if (at_ + 4 > size_) {
+            ok_ = false;
+            return 0;
+        }
+        uint32_t value = 0;
+        for (int i = 0; i < 4; i++) {
+            value |= static_cast<uint32_t>(data_[at_ + i]) << (8 * i);
+        }
+        at_ += 4;
+        return value;
+    }
+    int32_t I32() { return static_cast<int32_t>(U32()); }
+    float   F32() {
+        const uint32_t bits = U32();
+        float          value = 0.0f;
+        std::memcpy(&value, &bits, 4);
+        return value;
+    }
+    std::string Str() {
+        const uint32_t size = U32();
+        if (!ok_ || at_ + size > size_) {
+            ok_ = false;
+            return {};
+        }
+        std::string text(reinterpret_cast<const char *>(data_ + at_), size);
+        at_ += size;
+        return text;
+    }
+    std::vector<std::string> Strs() {
+        const uint32_t           count = U32();
+        std::vector<std::string> texts;
+        for (uint32_t i = 0; ok_ && i < count; i++) {
+            texts.push_back(Str());
+        }
+        return texts;
+    }
+
+private:
+    const uint8_t *data_;
+    size_t         size_;
+    size_t         at_ = 0;
+    bool           ok_ = true;
+};
+
+void WriteContext(Writer &w, const NpcContext &ctx) {
+    w.I32(ctx.map_no);
+    w.I32(ctx.npc_id);
+    w.I32(ctx.mes_id);
+    w.Str(ctx.mes_file_key);
+    w.Str(ctx.hub_greeting_key);
+    w.U32(static_cast<uint32_t>(ctx.bubble));
+    w.U32(ctx.has_anchor ? 1u : 0u);
+    w.F32(ctx.anchor_x);
+    w.F32(ctx.anchor_y);
+    w.U32(ctx.host_plays_original ? 1u : 0u);
+}
+
+NpcContext ReadContext(Reader &r) {
+    NpcContext ctx;
+    ctx.map_no = r.I32();
+    ctx.npc_id = r.I32();
+    ctx.mes_id = r.I32();
+    ctx.mes_file_key = r.Str();
+    ctx.hub_greeting_key = r.Str();
+    ctx.bubble = static_cast<BubbleKind>(r.U32());
+    ctx.has_anchor = r.U32() != 0;
+    ctx.anchor_x = r.F32();
+    ctx.anchor_y = r.F32();
+    ctx.host_plays_original = r.U32() != 0;
+    return ctx;
+}

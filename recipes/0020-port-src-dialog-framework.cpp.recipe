+        node.formatted_choice_labels = r.Strs();
+        node.selected_choice = r.I32();
+        node.choice_scroll_offset = r.I32();
+        node.hub = r.U32() != 0;
+        node.close_when_read = r.U32() != 0;
+        s.stack.push_back(std::move(node));
+    }
+    if (!r.Ok()) {

+bool ReadKept(Reader &r, KeptSession &s, std::string &why) {
+    s = KeptSession{};
+    s.active = r.U32() != 0;
+    s.last_end = static_cast<SessionEnd>(r.U32());
+    s.active_ctx = ReadContext(r);
+    s.original_message = r.Str();
+    s.snap_cursor = r.U32() != 0;
+    s.blink_counter = r.U32();
+    const uint32_t nodes = r.U32();
+    for (uint32_t n = 0; r.Ok() && n < nodes; n++) {
+        FrameNode      node;
+        const uint32_t slices = r.U32();
+        for (uint32_t i = 0; r.Ok() && i < slices; i++) {
~798 d26ef739242779fe|            |
+            slice.raw_text = r.Str();
+            slice.wrapped_markup_lines = r.Strs();
+            slice.wrapped_visible_lines = r.Strs();
+            node.slices.push_back(std::move(slice));
+        }
+        node.current_slice_idx = r.I32();
+        const uint32_t choices = r.U32();
+        for (uint32_t i = 0; r.Ok() && i < choices; i++) {
+            ChoiceItem item;
+            item.id = r.Str();
+            item.label_key = r.Str();
+            item.fallback_label = r.Str();
+            item.label_args = r.Strs();

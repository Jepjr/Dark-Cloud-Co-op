+// coop-localfix2: a frame of black (the arriving copy's door fade held while it takes the other copy's state and catches
+// up: NetplayArrivalHold), recorded once.
+const gfx::DisplayListRef &BlackList() {
+    static gfx::DisplayListRef black;
+    if (!black) {
+        gfx::BeginRecording(gfx::RecordingKind::Overlay);
+        if (!gfx::Recording()) {
+            return black;
+        }
+        const std::uint8_t color[4] = {0, 0, 0, 0x80};
+        gfx::Clear(true, color, false, 0.0f);
+        black = gfx::EndRecording();
+    }
+    return black;
+}
+
+bool PresentBlackFrame() {
+    const gfx::DisplayListRef &black = BlackList();
+    bool                       shown = black && gfx::RenderList(*black, 1.0f, {.present = true, .host = true});
+    if (shown) {
=374 a905cc304c069835
+    }
+    return shown;
+}

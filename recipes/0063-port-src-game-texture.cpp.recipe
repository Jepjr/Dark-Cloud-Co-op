+// Jep (co-op), coop-floorjoin2 (texture.hpp): the registry re-keyed to the table after a snapshot apply.
+void PortTextureRebuildBefore() {
+    for (int i = 0; i < 196; i++) {
+        const CTexture  &tex = TexManager.textures[i];
+        SlotBefore      &before = g_slots_before[i];
+        const sceGsTex0 &tex0 = *reinterpret_cast<const sceGsTex0 *>(&tex.tex0);
+        std::memcpy(before.name, tex.name, sizeof before.name);
+        before.tbp = tex0.TBP0;
+        before.cbp = tex0.CBP;
+        before.width = tex.width;
+        before.height = tex.height;
+        before.bpp = tex.bpp;
+    }
+}
+
+PortTextureRebuildReport PortTextureRebuildAfterApply() {
+    CTextureManager         &manager = TexManager;
+    PortTextureRebuildReport report;
+    bool                     moved[196] = {};
+
+    // Whose pixels a slot's image pointers are: a block texture's sit in game memory, staged in the manager's own buffer
+    // (TextureData) or, extended, in the caller's data (a floor's map), both in the state set, so the host's bytes are here
+    // now; a fixed texture's (block -1) and the Z sheet's (block 73) point at a load buffer long reused since (the first
+    // run of x-floor-join -Case late decoded the HUD's digit sheet from such a pointer: noise; its second, moving the
+    // floor's textures by name instead of decoding them, drew the floor black).
+    // coop-snapjoin: and only pixels the state set carried: in an arena block or in the image's globals. A town's or a
+    // building's texture may point at a heap buffer of the host's (a load buffer of the port's), which this copy has
+    // not: decoding from it read 0x558e0190 and faulted (o-opening-resync -Step house-during, 2026-10-25); such a
+    // texture moves by name as the boot sheets do (this copy loaded the same zone), else gets a placeholder.
+    // coop-provenance (cause: pointer provenance; LAN playtest 2026-10-30, item 37b, her crash in the apply): "in the image's globals"
+    // was "within 1 GB of the manager", and a host heap buffer 720 MB from it (Xiao's slingshot's palette) passed; decoding it
+    // faulted. Now the state set's own ranges: an arena block or a global of the snapregions. DC_NETPLAY_MUTATE=carried_near
+    // (twin): the 1 GB guess, as before.
+    static const bool near_guess = NetplayMutated("carried_near");
+    auto              carried = [&](const void *pixels) {
+        const auto at = reinterpret_cast<std::uintptr_t>(pixels);
+        const auto image = reinterpret_cast<std::uintptr_t>(&manager);
+        return near_guess ? ArenaContains(pixels) || (at > image ? at - image : image - at) < (std::uintptr_t{1} << 30)
+                          : SnapshotStateHolds(pixels);
+    };
+    // repin (9418a550): a block texture made from its baked document (or entered without pixels) is made again from its
+    // record (g_port_texture_source, in the state set) in step 3, as a fresh load makes it; only a texture the source decoder
+    // made from its pixels decodes from the pixels the table points at.
+    auto made = [&](int slot) { return g_port_texture_source[slot].made; };
+    auto staged = [&](const CTexture &tex) {
+        const int slot = static_cast<int>(&tex - manager.textures);
+        if (made(slot) != kTextureMadeOther) {
+            return tex.block >= 0 && tex.block < 72;
+        }
+        return tex.block >= 0 && tex.block < 72 && tex.image[0] != nullptr && carried(tex.image[0]) &&
+               (tex.clut == nullptr || carried(tex.clut));
+    };
+
+    static const bool        in_order = NetplayMutated("rekey_in_order");
+    std::vector<PortKeyMove> key_moves;
+
+    // coop-pt1108f: DC_COOP_TEST_REKEY_PLANT=1 (x-fixture-join -Case pictures, test_pictures_after_join): this copy's keys put so a
+    // move's target falls on a sheet still to move, as they came out on Jep's and the friend's PCs (the friend skipped the logos):
+    // "stayframe"'s palette (her menu's frame) where the table puts a sheet that moves before it. repin: the sheet is found by the
+    // table's slot order (the moves below go in that order), not by name: on Chronicle 9418a550's table "mes_frame_buff" no longer
+    // came before "stayframe", nothing collided, and the rekey_in_order twin passed blind.
+    if (std::getenv("DC_COOP_TEST_REKEY_PLANT") != nullptr) {
+        SlotBefore *stay = nullptr;
+        int         stay_slot = -1;
+        for (int i = 0; i < 196; i++) {
+            if (std::strcmp(g_slots_before[i].name, "stayframe") == 0) {
+                stay = &g_slots_before[i];
+            }
+            if (std::strcmp(manager.textures[i].name, "stayframe") == 0) {
+                stay_slot = i;
+            }
+        }
+        unsigned    onto = 0;
+        const char *first = nullptr;
+        for (int i = 0; i < stay_slot && onto == 0; i++) {
+            const CTexture &tex = manager.textures[i];
+            if (tex.name[0] == 0 || staged(tex) || (i == 0 && std::strcmp(tex.name, "work") == 0)) { // (as the moves below skip them)
+                continue;
+            }
+            const sceGsTex0 &tex0 = *reinterpret_cast<const sceGsTex0 *>(&tex.tex0);
+            for (int j = 0; j < 196; j++) {
+                const SlotBefore &before = g_slots_before[j];
+                if (&before != stay && before.tbp != 0 && std::strncmp(before.name, tex.name, sizeof before.name) == 0 && before.width == tex.width &&
+                    before.height == tex.height && before.bpp == tex.bpp && PortKeyLive(before.tbp) && tex0.TBP0 != before.tbp) {
+                    onto = tex0.TBP0;
+                    first = tex.name;

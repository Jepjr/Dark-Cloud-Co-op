+
+namespace {
+
+void RecordBakedSource(int slot, PortTextureMade made, const char *name, const std::string &document,
+                       std::optional<unsigned> entry_index, unsigned width, unsigned height, int bpp, const u_char *clut,
+                       std::size_t clut_bytes) {
+    PortTextureSource &source = g_port_texture_source[slot];
+    if (document.size() >= sizeof source.document) {
+        StopBakedTexture(name, "baked document path too long for the co-op texture record: " + document);
+    }
+    if (clut != nullptr && clut_bytes > sizeof source.clut) {
+        StopBakedTexture(name, "palette too long for the co-op texture record");
+    }
+    source = PortTextureSource{};
+    source.made = made;
+    source.entry_index = entry_index ? static_cast<int32_t>(*entry_index) : -1;
+    source.width = width;
+    source.height = height;
+    source.bpp = bpp;
+    source.clut_bytes = clut != nullptr ? static_cast<int32_t>(clut_bytes) : 0;
+    std::memcpy(source.document, document.data(), document.size());
+    if (source.clut_bytes > 0) {
+        std::memcpy(source.clut, clut, clut_bytes);
+    }
+}
+
+} // namespace

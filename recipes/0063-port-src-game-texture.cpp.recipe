+                }
+                const bool can = in_order ? PortMoveKeys(before.tbp, tex0.TBP0, before.cbp, tex0.CBP) : PortCanMoveKeys(before.tbp, tex0.TBP0, before.cbp, tex0.CBP);
+                if (can) {
+                    if (!in_order) {
+                        key_moves.push_back({before.tbp, tex0.TBP0, before.cbp, tex0.CBP});
+                    }
+                    moved[i] = true;
+                    g_slots_before[j].name[0] = 0; // taken: nothing of it to release below
+                    report.moved++;
+                }
+            }
+        }
+    }
+    PortMoveKeysTogether(key_moves);
+
+    // 2. The rest of this copy's manager entries name textures the table no longer holds: gone, except where a moved entry
+    //    now sits at one of their keys (the table's keys are its own).
+    auto held_by_moved = [&](unsigned key) {
+        for (int i = 0; i < 196; i++) {
+            const sceGsTex0 &tex0 = *reinterpret_cast<const sceGsTex0 *>(&manager.textures[i].tex0);
+            if (moved[i] && (tex0.TBP0 == key || tex0.CBP == key)) {
+                return true;
+            }
+        }
+        return false;
+    };
+    for (int j = 0; j < 196; j++) {
+        const SlotBefore &before = g_slots_before[j];
+        if (before.name[0] == 0) {
+            continue;
+        }
+        if (before.tbp != 0 && !held_by_moved(before.tbp)) {
+            PortReleaseKey(before.tbp);
+        }
+        if (before.cbp != 0 && !held_by_moved(before.cbp)) {
+            PortReleaseKey(before.cbp);
+        }
+    }
+
+    // 3. Every staged or extended texture again, at the table's keys, from the pixels the table points at (in the state
+    //    set with the table); placeholders and the water's "work" target as Initialize and Enter make them.
+    //    repin (9418a550): first every indexed baked slot's palette remembered by its name, as Enter did before its load: a
+    //    baked document picks a palette variant by another texture's remembered palette (PortRememberTextureClut).
+    for (int i = 0; i < 196; i++) {
+        const PortTextureSource &source = g_port_texture_source[i];
+        if (manager.textures[i].name[0] != 0 && source.made == kTextureMadeBaked && source.clut_bytes > 0) {
+            PortRememberTextureClut(manager.textures[i].name, source.clut, static_cast<std::size_t>(source.clut_bytes));
+        }
+    }
+    for (int i = 0; i < 196; i++) {
+        CTexture &tex = manager.textures[i];
+        if (tex.name[0] == 0 || moved[i]) {

+        }
+    }
+    // 1. Textures whose pixels are not the manager's (the title's and the menus' sheets, loaded at boot alike on both
+    //    copies): this copy's own entry of the same name, size and depth moves to the key the table holds now.
+    for (int i = 0; i < 196; i++) {
+        CTexture &tex = manager.textures[i];
+        if (tex.name[0] == 0 || staged(tex) || (i == 0 && std::strcmp(tex.name, "work") == 0)) {
+            continue;
+        }
+        // coop-provenance: a block texture left out for pixels the state set did not carry, said (the tests' line).
+        if (tex.block >= 0 && tex.block < 72 && tex.image[0] != nullptr && made(i) == kTextureMadeOther) {

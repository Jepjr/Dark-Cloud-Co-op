+                // coop-pt1108f: DC_NETPLAY_MUTATE=rekey_in_order (twin): one at a time, as before: a move evicts a sheet still to move.
+                if (std::getenv("DC_COOP_TEXLOG") != nullptr) { // (diagnostic: each boot sheet's move)

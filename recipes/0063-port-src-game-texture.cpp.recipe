+// Jep (co-op), coop-floorjoin2: whether each registry slot's staged pixels are in the swizzled layout, as Enter was told
+// (CTexture::swizzled keeps retail's meaning instead); the snapshot's state set carries it (build/snapshot-allow.txt)
+// for the rebuild.
+uint8_t g_port_texture_swizzled[196];
+
+// Jep (co-op), coop-floorjoin2 on 9418a550: how each slot's texture was made, so the rebuild after a snapshot makes it again
+// exactly as a fresh load does. A texture from its baked document (Enter, EnterFixTextureZ) is loaded again from that
+// document with the same arguments, the palette its variant was picked by included (the staged pixels are not what such a
+// texture shows, and an indexed one keeps no palette in the table); one entered without pixels is a placeholder again. The
+// state set carries the array with the table (build/snapshot-allow.txt), so after an apply it describes the sender's slots.
+// Plain data only: no pointers (CleanUpBuffer moves staged pixels) and no strings.
+enum PortTextureMade : uint8_t {
+    kTextureMadeOther = 0,       // decoded from its pixels (the source decoder), or nothing entered
+    kTextureMadeBaked = 1,       // Enter: PortLoadBakedTexture
+    kTextureMadeBakedZ = 2,      // EnterFixTextureZ: PortLoadBakedTexture, the Z sheet's way
+    kTextureMadePlaceholder = 3, // Enter without pixels: PortCreatePlaceholder
+};
+struct PortTextureSource {
+    uint8_t  made;
+    int32_t  entry_index; // the document's entry ordinal, -1 for none
+    uint32_t width;       // as the load was asked (the Z sheet's height is 0: any)
+    uint32_t height;
+    int32_t  bpp;         // the load's source_bpp (-1: not given)
+    int32_t  clut_bytes;  // the palette the load picked its variant by (0: none)
+    char     document[256];
+    u_char   clut[1024];
+};
+PortTextureSource g_port_texture_source[196];
+
+namespace {
+
+// Records a baked load's arguments for slot (PortTextureSource).
+void RecordBakedSource(int slot, PortTextureMade made, const char *name, const std::string &document,
+                       std::optional<unsigned> entry_index, unsigned width, unsigned height, int bpp, const u_char *clut,
+                       std::size_t clut_bytes);
+
+// What this copy's registry held, by slot, before another copy's snapshot was put back (PortTextureRebuildBefore).
+struct SlotBefore {
+    char     name[32];
+    unsigned tbp;
+    unsigned cbp;
+    short    width;
+    short    height;
+    short    bpp;
+};
+SlotBefore g_slots_before[196];
+
+} // namespace

+// coop-worlds: DC_WORLDS_TEST_GATE_SCAN=1: once, the town's ground on a 20-unit grid, each event polygon (a ground
+// kind above 0, the event walking onto it starts) logged once per kind with a point inside it, for the gate test's warp.
+static void TownGroundEventScan() {
+    static const bool scan = TestEnvInt("DC_WORLDS_TEST_GATE_SCAN", 0) != 0;
+    static bool       done = false;
+
+    if (!scan || done || pEditGround == NULL) {
+        return;
+    }
+
+    done = true;
+    static CCPoly polys[512];
+    struct Seen {
+        int   points;
+        float min[3], max[3], normal[3];
+    };
+    static Seen seen[512];
+
+    for (int x = -6000; x <= 6000; x += 20) {
+        for (int z = -6000; z <= 6000; z += 20) {
+            int count = pEditGround->PickUpPoly(polys, (float) x, 0.0f, (float) z);
+
+            for (int i = 0; i < count && i < 512; i++) {
+                int kind = polys[i].attr.ground_kind;
+
+                if (kind <= 0 || kind >= 512) {
+                    continue;
+                }
+
+                Seen &s = seen[kind];
+
+                for (int v = 0; v < 3; v++) {
+                    for (int k = 0; k < 3; k++) {
+                        float c = polys[i].vertex[v][k];
+
+                        s.min[k] = s.points == 0 && v == 0 ? c : std::min(s.min[k], c);
+                        s.max[k] = s.points == 0 && v == 0 ? c : std::max(s.max[k], c);
+                    }
+                }
+
+                for (int k = 0; k < 3; k++) {
+                    s.normal[k] = polys[i].normal[k];
+                }
+
+                s.points++;
+            }
+        }
+    }
+
+    for (int kind = 1; kind < 512; kind++) {
+        const Seen &s = seen[kind];
+
+        if (s.points > 0) {
+            std::fprintf(stderr, "worlds: test: ground event %d: %d grid hits, x %.0f..%.0f y %.0f..%.0f z %.0f..%.0f, normal (%.2f %.2f %.2f)\n",
+                         kind, s.points, s.min[0], s.max[0], s.min[1], s.max[1], s.min[2], s.max[2], s.normal[0], s.normal[1], s.normal[2]);
+        }
+    }
+
+    std::fflush(stderr);
+}

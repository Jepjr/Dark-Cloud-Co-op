+void CoopTownGeoramaPlotFromSave(int town, int plot) {
+    if (NowEditMap != town || SaveData == NULL) { // called in a town only
+        return;
+    }
+
+    SV_EDIT_PARTS_INFO *saved = SaveData->GetEditPartsInfo(town, plot);
+    EDITPARTS_INFO     *live = EditPartsInfo.GetPartsInfo(plot);
+
+    if (saved == NULL || live == NULL) {
+        return;
+    }
+
+    live->obtained = saved->obtained;
+    live->completion_flags = saved->completion_flags;
+    live->placed = saved->placed;
+    live->stock = saved->stock;
+
+    for (int element = 0; element < 6; element++) {
+        live->elements[element].enabled = saved->element_enabled[element];
+    }
+}

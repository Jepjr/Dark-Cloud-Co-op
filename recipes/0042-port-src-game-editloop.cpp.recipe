+static std::vector<EventFrameKeep> g_event_frames;
+
+static void KeepEventFrame(CFrame *frame, int depth) {
+    for (; frame != NULL; frame = depth > 0 ? frame->brother : NULL) {
+        EventFrameKeep keep{frame};
+
+        std::memcpy(keep.local, frame->local, sizeof keep.local);
+        sceVu0CopyVector(keep.scale, frame->scale);
+        sceVu0CopyVector(keep.position, frame->position);
+        sceVu0CopyVector(keep.rotation, frame->rotation);
+        keep.no_rotation = frame->no_rotation;
+        keep.rot_type = frame->rot_type;
+        keep.srt = frame->srt;
+        g_event_frames.push_back(keep);
+
+        // The named frames a script turns (a gate's two doors) are children of the part's frames.
+        if (depth < 8) {
+            KeepEventFrame(frame->child, depth + 1);
+        }
+    }
+}
+
+// Every part the event's object handles can take: the town's fixed parts, its placed (Georama) parts, such as
+// Norune's cave entrance, and the interior's parts, each frame with its children.
+static void KeepEventParts() {
+    g_event_frames.clear();
+
+    const struct {
+        CMapParts *parts;
+        int        count;
+    } lists[3] = {{EdEventInfo.fixed_parts, EdEventInfo.fixed_parts_count},
+                  {EdEventInfo.edit_parts, EdEventInfo.edit_parts_count},
+                  // coop-inbuild: the interior's only while inside one: out of it, EditInInit's pointer is left on parts whose
+                  // frames the town's load reused (player 1's copy read them in the town's next event and crashed).
+                  {EdInteriorFlag != 0 ? EdEventInfo.interior_parts : NULL, EdEventInfo.interior_parts_count}};
+
+    for (const auto &list : lists) {
+        for (int i = 0; list.parts != NULL && i < list.count; i++) {
+            CMapParts *part = &list.parts[i];
+            CFrame    *frames[9] = {part->frame[0],     part->frame[1],     part->frame[2],      part->frame[3],      part->GetCollisionFrame(),
+                                    part->shadow_frame, part->shade_frame, part->camera_frame, part->ripple_frame};
+
+            for (CFrame *frame : frames) {
+                KeepEventFrame(frame, 0);
+            }
+        }
+    }
+}

+
+static void RestoreEventParts() {
+    int moved = 0;
+
+    for (const EventFrameKeep &keep : g_event_frames) {
+        CFrame *frame = keep.frame;
+
+        moved += std::memcmp(keep.position, frame->position, sizeof keep.position) != 0 ||
+                 std::memcmp(keep.rotation, frame->rotation, sizeof keep.rotation) != 0 || keep.rot_type != frame->rot_type ||
+                 std::memcmp(keep.local, frame->local, sizeof keep.local) != 0;
+
+        if (CoopWorldsMutated("keep_gate_open")) {
+            continue;
+        }
+
+        frame->SetScale((float *) keep.scale);
+        frame->SetPosition((float *) keep.position);
+        frame->SetRotation(keep.rotation[0], keep.rotation[1], keep.rotation[2]);
+        std::memcpy(frame->local, keep.local, sizeof keep.local);
+        frame->no_rotation = keep.no_rotation;
+        frame->rot_type = keep.rot_type;
+        frame->srt = keep.srt;
+        frame->world_valid = 0;
+    }
+
+    std::fprintf(stderr, "worlds: staying: the town event's parts %s (%zu frames, %d had moved)\n",
+                 CoopWorldsMutated("keep_gate_open") ? "left as the event moved them" : "put back", g_event_frames.size(), moved);
+}

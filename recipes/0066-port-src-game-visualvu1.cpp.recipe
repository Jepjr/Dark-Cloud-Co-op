+// Jep (co-op): coop-toanvis, coop-joinatla, coop-pond, coop-warmreset. At 6ec3b808 this sat beside the draw records in
+// port/src/visualvu1.cpp; 9418a550 moved the records to render/draw3d_visual.cpp, and this stays with the model builds
+// it watches (CreateVUdataFromMDT keeps each model and names it in its block).
+namespace {
+
+// coop-joinatla (Jep's 2026-10-28 run: the fairy king's warp boxy on P2's screen after she joined his B1 lesson): the
+// print covers the whole model, not its header alone. The warp's glow and another model of hers (e01s01_1's) had the
+// same header, so her copy rebuilt the glow from the other model's data, whose texture the table did not hold: white
+// quads. DC_COOP_MUTATE=header_print (twin): the header alone, as before.
+uint32_t MdtPrint(const unsigned int *data) {
+    static const bool header_only = [] {
+        const char *mutation = std::getenv("DC_COOP_MUTATE");
+        return mutation != nullptr && std::strstr(mutation, "header_print") != nullptr;
+    }();
+    const size_t size = reinterpret_cast<const MDT_HEADER *>(data)->size;
+    const size_t words = header_only || size < sizeof(MDT_HEADER) || size > (32u << 20) ? sizeof(MDT_HEADER) / 4 : size / 4;
+    uint32_t     print = 0x811c9dc5u;
+    for (size_t i = 0; i < words; i++) {
+        print = (print ^ data[i]) * 0x01000193u;
+    }
+    return print | 1u; // never 0: 0 is "no source" (a shadow's or another kind's record)
+}
+
+unsigned int *BlockSource(const unsigned int *block) {
+    return reinterpret_cast<unsigned int *>(static_cast<uintptr_t>(block[9]) | (static_cast<uintptr_t>(block[10]) << 32));
+}
+
+// coop-toanvis: every model built, as it was, by its header's print (a model's file is often gone by the time a state set
+// needs it again: the dungeon's read buffer is reused). Oldest first out past kLibraryBytes.
+constexpr size_t kLibraryBytes = 64u << 20;
+constexpr size_t kLibraryModelBytes = 2u << 20;
+
+std::unordered_map<uint32_t, std::vector<unsigned int>> g_library;
+std::vector<uint32_t>                                    g_library_order;
+size_t                                                   g_library_bytes = 0;
+
+void KeepModel(const unsigned int *data, uint32_t print) {
+    const size_t size = reinterpret_cast<const MDT_HEADER *>(data)->size;
+    if (size < sizeof(MDT_HEADER) || size > kLibraryModelBytes || g_library.count(print) != 0) {
+        return;
+    }
+    g_library[print].assign(data, data + (size + 3) / 4);
+    g_library_order.push_back(print);
+    g_library_bytes += size;
+    while (g_library_bytes > kLibraryBytes && !g_library_order.empty()) {
+        auto it = g_library.find(g_library_order.front());
+        g_library_order.erase(g_library_order.begin());
+        if (it != g_library.end()) {
+            g_library_bytes -= it->second.size() * 4;
+            g_library.erase(it);
+        }
+    }
+}
+
+unsigned int *KeptModel(uint32_t print) {
+    auto it = g_library.find(print);
+    return it != g_library.end() && MdtPrint(it->second.data()) == print ? it->second.data() : nullptr;
+}
+
+int      g_stale_visuals = 0;
+int      g_rebuilt_visuals = 0;
+uint32_t g_state_epoch = 0;       // coop-pond: state sets applied (Draw3DStateSetApplied)
+int      g_remade_after_set = 0;  // coop-pond: records remade once after a state set (RemakeAfterStateSet)
+int g_untextured_strips = 0; // coop-joinatla: strips built whose material names a texture the table does not hold
+int g_visual_job = 0;        // coop-warmreset (Draw3DResetForJob)
+
+// coop-pond (Jep's LAN pack 8 playtest, 2026-11-04: Norune's pond on his screen, flat ground on his partner's): a remakeable
+// model (CVisualMDTVu1) the game edits in place follows its edits only on a remake flag. A town's ground grid is one:
+// CEditArea::RemakeGrid folds the cells a pond or river digs out and raises the flag. A state set brought the host's folded
+// ground but not the flag he spent long before, so her copy's record stayed her own whole ground: it covered the pond's pit,
+// fence and water. Once after each state set (Draw3DStateSetApplied), each such record is remade from the model as it is.
+// DC_COOP_MUTATE=no_remake_after_set (twin): left as it was.
+Draw3DVisual *RemakeAfterStateSet(CVisualVu1 *owner, unsigned int *block, Draw3DVisual *visual) {
+    static const bool keep = [] {
+        const char *mutation = std::getenv("DC_COOP_MUTATE");
+        return mutation != nullptr && std::strstr(mutation, "no_remake_after_set") != nullptr;
+    }();
+    if (visual == nullptr || visual->immediate || visual->state_epoch == g_state_epoch) {
+        return visual;
+    }
+    visual->state_epoch = g_state_epoch;
+    u_int *model = owner->GetMDTDataAddress();
+    if (keep || model == nullptr || !ArenaContains(model)) {
+        return visual;
+    }
+    u_int *const was_data = owner->vu_data;
+    const u_int  was_size = owner->vu_size;
+    owner->CreateVUdataFromMDTRemake(block, model, 1);
+    owner->vu_data = was_data;
+    owner->vu_size = was_size;
+    g_remade_after_set++;
+    return Draw3DFindVisual(block);
+}
+
+} // namespace
+
+// coop-joinatla: the print a model block names its model by (coop_scenepics.cpp indexes the scene's packs by it).
+uint32_t Draw3DModelPrint(const unsigned int *data) {
+    return MdtPrint(data);
+}
+

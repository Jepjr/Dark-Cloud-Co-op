+namespace dc::render {
+
+using namespace dc::game;
+
+void Draw3DStateSetApplied() {
+    g_state_epoch++;
+}
+
+int Draw3DRemadeAfterStateSets() {
+    return g_remade_after_set;
+}
+
+int Draw3DStaleVisuals() {
+    return g_stale_visuals;
+}
+
+int Draw3DRebuiltVisuals() {
+    return g_rebuilt_visuals;
+}
+
+// coop-warmreset (test-time plan WS7 step 1): a warm pair's job counts its stale blocks from none and says its first ones again, as
+// a fresh copy does (process totals made a later job's "built again" / "nothing drawn" lines and the join's totals the jobs' sum).
+// netplay.cpp's job start calls it; the trace_once_kept twin does not. The kept-model library stays (a fresh copy has the
+// models of its own floor's build in it too).
+void Draw3DResetForJob() {
+    g_stale_visuals = 0;
+    g_rebuilt_visuals = 0;
+    g_visual_job++;
+}
+
+// coop-toanvis (Jep's 2026-10-26 playtest: Toan only a shadow on P2's screen after she joined his floor): a model block
+// carries, past its tag, the model it was built from (its address and header's print), so the block says what it holds
+// wherever its bytes came from. Player 2's copy had become Xiao alone on the floor, so the player's blocks held Xiao's
+// records; the merge's state set put Toan's model there (other blocks, other models), and the records kept Xiao's meshes
+// or none. A block whose record is missing or built from another model is built again from that model: where the block
+// says it is while it is still there (its print), else this copy's own copy of it (KeepModel: her copy built Toan's at
+// the floor's start); with neither, its stale record goes. DC_COOP_MUTATE=stale_visuals (twin): counted, left as it is.
+Draw3DVisual *Draw3DEnsureVisual(CVisualVu1 *owner, unsigned int *block) {
+    static const bool keep_stale = [] {
+        const char *mutation = std::getenv("DC_COOP_MUTATE");
+        return mutation != nullptr && std::strstr(mutation, "stale_visuals") != nullptr;
+    }();
+
=763 a494fb17e3ec8c50
+    if (block == nullptr || !Draw3DBlockTagged(block) || block[11] == 0) {
+        return visual;
+    }
+    unsigned int *source = BlockSource(block);
+    if (visual != nullptr && (visual->immediate || (visual->source == source && visual->source_print == block[11]))) {
+        return RemakeAfterStateSet(owner, block, visual);
+    }
+    // coop-b6monsters (Jep's 2026-11-04 pack 8 run, x-floor7-zone): on the copy that joined a scene part-way, a block the state
+    // set carried can name a model in the dungeon's read buffer, which the set leaves out: there the arena holds this copy's
+    // own bytes, whose "size" ran the print past the arena's end (an access violation as floor 7's scene ended). The model
+    // must lie whole in the arena before it is read; one that runs past it is said and not read. DC_COOP_MUTATE=source_whole
+    // (twin): its first word alone, as before, so the model is taken for whole and said "read past the arena", but not read
+    // (the read is the access violation itself, which a twin must not take: it fails on the test's check instead).
+    static const bool first_word_only = [] {
+        const char *mutation = std::getenv("DC_COOP_MUTATE");
+        return mutation != nullptr && std::strstr(mutation, "source_whole") != nullptr;
+    }();
+    bool whole = false;
+    if (ArenaContains(source)) {
+        const size_t size = reinterpret_cast<const MDT_HEADER *>(source)->size;
+        whole = size < sizeof(MDT_HEADER) || size > (32u << 20) || ArenaContains(reinterpret_cast<const unsigned char *>(source) + size - 1);
+        static int told = 0;
+        static int told_job = 0;
+        if (told_job != g_visual_job) {
+            told_job = g_visual_job;
+            told = 0;
+        }
+        if (!whole && told++ < 20) {
+            std::fprintf(stderr, "draw3d: model block %p names a model at %p running past the arena (%zu bytes): %s\n",
+                         static_cast<void *>(block), static_cast<void *>(source), size,
+                         first_word_only ? "taken for whole, read past the arena (source_whole)" : "not read");
+        }
+    }
+    unsigned int *model = whole && MdtPrint(source) == block[11] ? source : KeptModel(block[11]);
+    // coop-b1lesson: or the other copy's scene's model, from this copy's own read of the packs that scene read.
+    if (model == nullptr) {
+        model = CoopWorldsSceneModel(block[11]);
+    }
+    // coop-joinatla (Jep, 2026-10-28: after B1, P2 rejoined his town scene and "can't see the fairy king"; no log of it was kept):
+    // a model this copy cannot build again is said every time (up to 40), not only among the first 12 rebuilds of the session.
+    static int lost = 0;
+    static int lost_job = 0;
+    if (lost_job != g_visual_job) {
+        lost_job = g_visual_job;
+        lost = 0;
+    }
+    if (model == nullptr && g_stale_visuals >= 12 && lost++ < 40) {
+        std::fprintf(stderr, "draw3d: model %08x of block %p is not on this copy (neither here, kept nor in a scene's packs): nothing drawn\n",
+                     block[11], static_cast<void *>(block));
+    }
+    if (g_stale_visuals++ < 12) {
+        std::fprintf(stderr, "draw3d: model block %p %s, its model %p %s (%s)\n", static_cast<void *>(block),
+                     visual ? "built from another model" : "has no mesh", static_cast<void *>(source),
+                     model == source ? "here" : model ? "gone, this copy keeps it" : "gone",
+                     keep_stale ? "left as it is: stale_visuals" : model ? "built again" : "nothing drawn");
+    }
+    if (keep_stale) {
+        return visual;
+    }
+    if (model != nullptr) {
+        // The build names its model in the block; the block keeps the name it came with (both copies' bytes alike).
+        const unsigned int named[3] = {block[9], block[10], block[11]};
+        u_int *const       was_data = owner->vu_data;
+        const u_int        was_size = owner->vu_size;
+        const int          untextured = g_untextured_strips;
+        owner->CreateVUdataFromMDT(block, model, 0, 0);
+        // coop-joinatla: a rebuilt model whose textures the table lacks drew as plain quads (the fairy king's warp, built from
+        // another model of one header). Said, for the tests (x-floor-join -Case scene).
+        static int told = 0;
+        static int told_job = 0;
+        if (told_job != g_visual_job) {
+            told_job = g_visual_job;
+            told = 0;
+        }
+        if (g_untextured_strips != untextured && told++ < 20) {
+            std::fprintf(stderr, "draw3d: model %08x built again with %d strip(s) whose texture the table does not hold\n", block[11],
+                         g_untextured_strips - untextured);
+        }
+        owner->vu_data = was_data;
+        owner->vu_size = was_size;
+        std::memcpy(block + 9, named, sizeof named);
+        visual = Draw3DFindVisual(block);
+        g_rebuilt_visuals++;
+    } else if (visual != nullptr) {
+        Draw3DReleaseVisual(*visual);
+        visual->strips.clear();
+        visual->vertices.clear();
+    }
+    if (visual != nullptr) {
+        visual->source = source;
+        visual->source_print = block[11];
+    }
+    return RemakeAfterStateSet(owner, block, visual);
+}
+
+// Jep (co-op): which of a remakeable model's two blocks it is remade into and drawn from (render/draw3d.hpp). 9418a550
+// draws from block 0 alone, as this did by default; DC_COOP_MUTATE=mdt_double_buffer keeps retail's two (the
+// interpolation test's twin).
+int Draw3DModelBuffer() {
+    static const bool two = [] {
+        const char *mutation = std::getenv("DC_COOP_MUTATE");
+        return mutation != nullptr && std::strcmp(mutation, "mdt_double_buffer") == 0;
+    }();
+
+    return two ? DBuffID : 0;
+}
+
+} // namespace dc::render

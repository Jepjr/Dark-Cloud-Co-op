+            const auto         found = file != nullptr ? prefetched.find(file) : prefetched.end();
+            if (file == nullptr || (found != prefetched.end() && found->second.epoch == data_index_epoch)) {
+                continue;
+            }
+            std::promise<PrefetchBytes> promise;
+            prefetched[file] = {data_index_epoch, promise.get_future().share()};
+            work.emplace_back(*file, std::move(promise));
+        }
+        std::erase_if(prefetch_jobs, [](const std::future<void> &job) { return job.wait_for(std::chrono::seconds(0)) == std::future_status::ready; });
+        if (work.empty()) {
+            return;
+        }
+        prefetch_jobs.push_back(std::async(std::launch::async, [work = std::move(work)]() mutable {
+            for (auto &[file, promise] : work) {

+                if (!ReadResolved(&file, *bytes)) {
+                    bytes.reset();
+                }
+                promise.set_value(std::move(bytes));
+            }
+        }));
+    }
+}
+
+void DataReadLoadCounts(std::uint64_t *loads, std::uint64_t *from_prefetch) {
+    *loads = loads_done.load(std::memory_order_relaxed);
+    *from_prefetch = loads_prefetched.load(std::memory_order_relaxed);
+}

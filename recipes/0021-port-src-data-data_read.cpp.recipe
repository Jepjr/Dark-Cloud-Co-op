+// Jep (co-op), coop-wepmenu (the developer's v0.2-rc4 playtest, 11-18: "when you open the weapons menu for the first time the
+// game freezes for a second"): the reads a menu page makes as it opens (LoadFileBG: retail read them in the background over the
+// following frames, the port reads them whole on the game thread) cost each file's first open, its bytes aside: a cold
+// commenu/a_usa/kgetoan2.img (182 KB) 9.0 ms, commenu/c01wtes.chr (1.2 MB) 0.97 ms; warm 0.10 and 0.34 ms (PC-01, a data copy
+// never opened before). DataReadPrefetch reads named files on a thread of their own ahead of their page; DataReadLoadFile then
+// copies the same bytes from memory (waiting for one still on its way), so the result is the read's own, byte for byte. The
+// prefetched bytes live here, in the data layer, outside the game's state.
+namespace {
+
+using PrefetchBytes = std::shared_ptr<const std::vector<std::uint8_t>>;
+
+struct Prefetched {
+    std::uint64_t                     epoch = 0;
+    std::shared_future<PrefetchBytes> bytes;
+};
+
+std::mutex                                        prefetch_mutex;
+std::unordered_map<const IndexedFile *, Prefetched> prefetched;
+std::vector<std::future<void>>                    prefetch_jobs; // (each joined before it is dropped, the last at exit)
+std::atomic<std::uint64_t>                        loads_done{0};
+std::atomic<std::uint64_t>                        loads_prefetched{0};
+
+PrefetchBytes PrefetchedFor(const IndexedFile *file) {
+    std::shared_future<PrefetchBytes> bytes;
+    {
+        const std::scoped_lock lock(prefetch_mutex);
+        const auto             found = prefetched.find(file);
+        if (found == prefetched.end() || found->second.epoch != data_index_epoch) {

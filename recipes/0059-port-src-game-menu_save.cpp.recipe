+// coop-keylook (Jep: a duplicated menu must look like the original): a co-op player's own Use Item window drawn by the game's own
+// EventItemSelectDraw: the window's globals are hers for the call (MiniMenu, its places, eases, pictures, pack and message window),
+// then back. Drawing only, on the copy that shows it.
+void EventItemDrawStart(EventItemDraw &draw, float x, float y, ITEM_PACK *pack, int event_items, int cursor) {
+    draw.menu = MINI_MENU_INFO{};
+    draw.menu.fish_mode = 0;
+    draw.menu.lang = GetMenuLangFlag();
+    draw.menu.event_item_num = static_cast<s16>(event_items);
+    draw.menu.cursor = cursor;
+    draw.menu.scroll_row = 0;
+    draw.menu.state = MINI_MENU_FADE_IN;
+    draw.menu.state_time = 0;
+    draw.board_pos[0] = x;
+    draw.board_pos[1] = y;
+    draw.pack = pack;
+
+    int rows = pack->num / 5;
+
=1012 383950cc0e6d95c4
+        rows = 1;
+    }
+    // (InitEventItemSelect's, cursor 0, scroll 0: the rule below scrolls to the cursor as the game's key step does)
+    draw.move_y = static_cast<int>(56.0f + y);
+    draw.bar_y = 60.0f + y + static_cast<int>(68.0f * 0) / rows;
+    draw.cur[0] = 6.0f + x;
+    draw.cur[1] = 60.0f + y;
+}
+
+void EventItemDrawAs(EventItemDraw &draw, int cursor) {
+    // EventItemSelectKey's scroll rule, one row a frame, for the cursor the picker steps
+    draw.menu.cursor = cursor;
+    if (draw.menu.cursor < draw.menu.scroll_row * 5) {
+        draw.menu.scroll_row--;
+    }
+    if ((draw.menu.scroll_row + 2) * 5 - 1 < draw.menu.cursor) {
+        draw.menu.scroll_row++;
+    }
+
+    std::swap(MiniMenu, draw.menu);
+    std::swap(EventBoardPos[0], draw.board_pos[0]);
+    std::swap(EventBoardPos[1], draw.board_pos[1]);
+    std::swap(EventItemMoveY, draw.move_y);
+    std::swap(MiniCur[0], draw.cur[0]);
+    std::swap(MiniCur[1], draw.cur[1]);
+    std::swap(EventBarY, draw.bar_y);
+    std::swap(MiniEventBoard, draw.board);
+    std::swap(ItemIcon, draw.icons);
+    std::swap(EventItemPackPt, draw.pack);
+    std::swap(MiniEventTextureBlock, draw.block);
+    std::swap(CommonMenuMes2, *draw.mes);
+
+    CTexture *stay = StayTex;
+    const int read = MiniEventTexReadFlag;
+

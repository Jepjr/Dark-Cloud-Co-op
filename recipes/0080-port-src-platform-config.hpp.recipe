+    bool              netplay_controller_only = true;
+    // game.netplay_keyboard (or DC_NETPLAY_KEYBOARD=1): with game.netplay_controller_only, the keyboard still plays
+    // (it folds into this copy's pad, which the link sends); the mouse stays out. For a player with no controller. Off.
+    bool              netplay_keyboard = false;
+    // game.netplay_wan_lookup: one client hosting asks a STUN server (DC_NETPLAY_STUN, or stun.l.google.com:19302) for
+    // this PC's internet address, to show it. On; false (or DC_NETPLAY_STUN=off) asks nobody.
+    bool              netplay_wan_lookup = true;
+    // coop-upnp: game.netplay_upnp: a host by Multi-player > Host > IP (or NAT > Code) asks the router by UPnP to forward its

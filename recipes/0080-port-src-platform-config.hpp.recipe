+    // a manual port forward (port/src/coop/netplay_upnp.hpp; DC_NETPLAY_UPNP=1 or 0 overrides). On; false asks nobody.
+    bool              netplay_upnp = true;
+    // coop-lobby: game.lobby_local, where players on this PC come in: "combined" (any

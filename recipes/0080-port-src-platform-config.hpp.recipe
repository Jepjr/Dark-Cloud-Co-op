+    float             area_card_speed = 1.0f;
+    bool              area_card_coop_only = true;
+    // coop-snapshot: game.netplay_snapshot (or DC_NETPLAY_SNAPSHOT=1): a catch-up join on a dungeon floor sends the host's
+    // state as a memory snapshot and the joiner replays only the ticks since. Takes effect
+    // only in a build with the fixed layout (DC_FIXED_LAYOUT: the two copies hold the game's memory at one address);
+    // elsewhere a join catches up as before. Off.
+    bool              netplay_snapshot = false;
+    // coop-steamrate: game.netplay_steam_rate: how fast a join's state goes over Steam. 0 or "auto" (the default): the
+    // host paces by what reaches the joiner, starting at 1 MB/s and rising to at most 40 MB/s, backing off when pieces
+    // are lost. A number is a fixed rate in KB/s (e.g. 2048), or text with its unit ("512 KB/s", "2 MB/s"), from
+    // 64 KB/s to 1024 MB/s: Steam sends at exactly that rate, no pacing (DC_STEAM_SEND_RATE, bytes a second, overrides).
+    // Held here in KB/s.
+    int               netplay_steam_rate = 0;
+    // coop: cameras

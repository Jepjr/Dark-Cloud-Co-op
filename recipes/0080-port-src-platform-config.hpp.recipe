+    // DC_LOBBY_LOCAL overrides. game.netplay_last_code: the code Join > Code joined last (its entry opens with it).
+    // game.netplay_player_id: this copy's own lobby identity (16 hex digits, made once), so a rejoin gets its seat back.
+    std::string       lobby_local = "combined";
+    std::string       netplay_last_code;
+    std::string       netplay_player_id;
+    // coop-consent (Jep, 2026-11-02: the player's own call): game.lobby_show_ip: the host's outside IP shown in the lobby's

@@ -186,0 +285,8
+// coop: settings for this run only, never written to config.json (the title's Multi-player turns co-op on for the
+// session it starts). apply sets them on the running settings; restore copies the saved values of the same keys from
+// saved into the settings about to be saved. ConfigChange keeps both apart while a session is set; nullptr ends it
+// (the running settings go back to the saved ones). The change hooks run as for ConfigChange.
+using ConfigSessionApply = void (*)(Config &config);
+using ConfigSessionRestore = void (*)(Config &config, const Config &saved);
+void ConfigSetSession(ConfigSessionApply apply, ConfigSessionRestore restore);

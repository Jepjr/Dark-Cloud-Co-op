+// coop-housecrash test hook (DC_COOP_TEST_ROOM_CAM_SHIFT=BYTES[:R]): the copy of role R (2 unless said) runs SetCameraPos
+// BYTES deeper in its stack, as another PC's stack lies, so a stack address it keeps differs from the other copy's. The
+// switch is read each call: a pointer kept in this file's statics would cross to the other copy with the state set too.
+// (The fix it tests is upstream's own since 90a03500: active_camera is kept by its place in the list.)
+void CoopRoomCameraStep(CFrame *frame) {
+    if (const char *shift = TestEnv("DC_COOP_TEST_ROOM_CAM_SHIFT"); shift != nullptr) {
+        char      *rest  = nullptr;
+        const long bytes = std::strtol(shift, &rest, 0);
+        const int  role  = rest != nullptr && *rest == ':' ? std::atoi(rest + 1) : 2;
+
+        if (bytes > 0 && NetplayRole() == role) {
+            static bool said = false;
+
+            if (!said) {
+                said = true;
+                std::fprintf(stderr, "edit_in: test: the room camera steps %ld bytes deeper on this copy (player %d)\n", bytes, role);
+            }
+
+            volatile char *pad = static_cast<volatile char *>(__builtin_alloca(static_cast<size_t>(bytes)));
+            pad[bytes - 1]     = 0;
+            SetCameraPos(frame, &EdIn_MainCamera, EdIn_Chara);
+            pad[0] = 0;
+            return;
+        }
+    }
+
+    SetCameraPos(frame, &EdIn_MainCamera, EdIn_Chara);
+}
+
+} // namespace

+    ED_EVENT_RANGE(sync_camera_ref_obj);
+    ED_EVENT_RANGE(sync_camera_pos_obj);
+    ED_EVENT_RANGE(BaseBuffer);
+    ED_EVENT_RANGE(actv_file);
+    ED_EVENT_RANGE(actv_buffer);
+    ED_EVENT_RANGE(CurrentDir);
+    ED_EVENT_RANGE(world_pos);
+    ED_EVENT_RANGE(world_rot);
+    ED_EVENT_RANGE(world_local);
+    ED_EVENT_RANGE(local_world);
+    ED_EVENT_RANGE(sync_camera_ref_offset);

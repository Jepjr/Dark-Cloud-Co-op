+// coop-eventslots: a script's own state outside its CRunScript (the host-sized operand and call stacks the VM keeps for it, and
+// the last run's result), as ranges for a parked event slot (port/src/coop/coop_eventslots.cpp) to exchange around its steps.
+void RunScriptStateRanges(const CRunScript *script, void (*add)(void *at, std::size_t bytes, const char *name, void *context), void *context) {
+    HostStacks &host = StacksFor(script);
+
+    if (host.stack != nullptr) {
+        add(host.stack, sizeof(RS_STACKDATA) * static_cast<std::size_t>(host.stack_num), "vm stack", context);
+    }
+    if (host.call != nullptr) {
+        add(host.call, sizeof(RS_CALLDATA) * static_cast<std::size_t>(host.call_num), "vm calls", context);
+    }
+    add(&g_run_result, sizeof g_run_result, "g_run_result", context);
+}

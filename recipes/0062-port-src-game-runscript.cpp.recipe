+// coop-snapshot (port/src/coop/snapshot_state.cpp): the VM's state that lives on the C heap, each interpreter's
+// host-sized stacks and every decoded function record, so a snapshot taken and put back in one copy covers a script
+// under way. The blocks stay where they are while no script is loaded between the take and the restore.
+void RunScriptForEachHeapBlock(void (*visit)(void *start, std::size_t size, const char *name, void *context), void *context) {
+    // The VM's state lives in its arena now (VmAlloc), which ArenaForEach lists: no heap blocks of its own.
+    (void) visit;
+    (void) context;
+}

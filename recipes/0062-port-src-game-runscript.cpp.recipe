@@ -61,0 +75,55
+// coop-scenejoin: the VM's bookkeeping lives in its arena too, at the block's start: how much of it is used, which record
+// (by its address in the loaded file) was decoded where, and each interpreter's stacks. It was a global count and two C-heap
+// maps, which a state set did not carry: after another copy's set went in, this copy's maps still named its own places in
+// the arena, now the other's (a new record decoded there wrote over the other's stacks), and its count could hand out what
+// the other had in use. Both keys are places the two copies share (a loaded file in a pinned arena, a global interpreter),
+// so the tables mean the same on both. Open addressing, never removed from (records are rewritten in place, as before).
+constexpr std::uint64_t kVmMagic = 0x31564d5653435344ull; // "DSCSVMV1"
+constexpr std::size_t   kRecordSlots = 1u << 18;
+constexpr std::size_t   kStackSlots = 256;
+
+struct RecordSlot {
+    const char *key;
+    funcdata   *slot;
+};
+
+struct StackSlot {
+    const CRunScript *key;
+    HostStacks        host;
+};
+
+struct VmBook {
+    std::uint64_t magic;
+    std::size_t   used; // bytes of the arena given out, this book included
+    std::size_t   records;
+    std::size_t   stacks;
+    RecordSlot    record[kRecordSlots];
+    StackSlot     stack[kStackSlots];
+};
+
+VmBook *Book() {
+    auto *book = reinterpret_cast<VmBook *>(ArenaBlock(&g_vm_arena_owner, kVmArenaBytes));
+    if (book->magic != kVmMagic) {
+        std::memset(book, 0, sizeof(VmBook));
+        book->magic = kVmMagic;
+        book->used = (sizeof(VmBook) + 63) & ~static_cast<std::size_t>(63);
+    }
+    return book;
+}
+
+std::size_t SlotOf(const void *key, std::size_t slots) {
+    return static_cast<std::size_t>((reinterpret_cast<std::uintptr_t>(key) >> 3) * 0x9e3779b97f4a7c15ull >> 40) & (slots - 1);
+}
+
+void *VmAlloc(std::size_t bytes) {
+    VmBook *book = Book();
+    bytes = (bytes + 63) & ~static_cast<std::size_t>(63);
+    if (book->used + bytes > kVmArenaBytes) {
+        std::fprintf(stderr, "runscript: the script VM's arena is full (%zu + %zu of %zu bytes)\n", book->used, bytes, kVmArenaBytes);
+        std::abort();
+    }
+    void *out = reinterpret_cast<unsigned char *>(book) + book->used;
+    book->used += bytes;
+    return out;
+}
+

+// coop: minimap
+// A player's arrow at x, y (the pivot, where the player stands) facing angle. Player 1's keeps retail's arrow;
+// player 2's takes another colour over a dot of it on either copy (CoopMiniMapArrowColour; coop-uinotice, Jep's
+// 2026-10-30 "fixed colours per player"), so each player is one colour on both screens.
+void DrawArrow(CTexture *symbol_texture, int x, int y, float angle, bool other) {
+    u_char red = 0x80, green = 0x80, blue = 0x80;
+
+    if (CoopMiniMapArrowColour(other, &red, &green, &blue)) {
+        set2DSprite(Vif1Packet, symbol_texture, CRect_i_(x - 3, y - 3, 6, 6), CRect_i_(88, 96, 12, 12), red, green, blue, 0x80);
+    }
+
+    render::draw2d::TurnedSprite(symbol_texture, CRect_i_(x, y, 12, 12), CRect_i_(88, 96, 12, 12), 7, 7, angle, 1.0f, red, green,
+                                 blue);
+}
+
+} // namespace
+

@@ -1338,0 +1411,10
+// coop: netplay
+// The map builder's grid with a guard of 20 cells either side. Retail reads the row above row 0 and the row
+// below row 19 (setStair, setUnderDungeonStart) and writes a stair above a corridor in row 0, so it reaches past
+// buildMapDat into whatever the linker put beside it; in the port that is unrelated globals, which differ
+// between a copy that has played a while and one that has not, and two linked copies then build the same floor
+// differently. The guards (the linker orders .data$ sections by name) take those reads and writes instead, and
+// a resync clears them on both copies (PortBuildMapGuardsClear), so both build alike from then on.
+// Jep (co-op): a deliberate divergence from upstream, which places buildMapDat between scanRoomInfoWork and buildMapWork so the
+// strays land where retail had them (Jep kept the guards, 2026-11-10): docs\upstream-divergences.md, "floor builder".
+__attribute__((section(".data$dcbuildmap_a"), used)) BUILD_MAP_INFO g_build_map_before[20] = {};
@@ -1340,1 +1422,23
- 07d46e2e11ec22c0
+BUILD_MAP_INFO buildMapDat[400] __attribute__((section(".data$dcbuildmap_b"))) = {};
+__attribute__((section(".data$dcbuildmap_c"), used)) BUILD_MAP_INFO g_build_map_after[20] = {};
+
+void PortBuildMapGuardsClear() {
+    std::memset(g_build_map_before, 0, sizeof g_build_map_before);
+    std::memset(g_build_map_after, 0, sizeof g_build_map_after);
+}
+
+// A test's way to leave one copy's guards as a long session might (DC_NETPLAY_PERTURB_GUARD).
+void PortBuildMapGuardsFill(unsigned char value) {
+    std::memset(g_build_map_before, value, sizeof g_build_map_before);
+    std::memset(g_build_map_after, value, sizeof g_build_map_after);
+}
+
+// Whether the guards sit right before and after buildMapDat, as they must to take its stray reads.
+bool PortBuildMapGuardsPlaced() {
+    // As addresses: the compiler may take two arrays' pointers for unequal whatever the linker did.
+    volatile std::uintptr_t before = reinterpret_cast<std::uintptr_t>(g_build_map_before);
+    volatile std::uintptr_t grid = reinterpret_cast<std::uintptr_t>(buildMapDat);
+    volatile std::uintptr_t after = reinterpret_cast<std::uintptr_t>(g_build_map_after);
+
+    return before + sizeof g_build_map_before == grid && grid + sizeof buildMapDat == after;
+}

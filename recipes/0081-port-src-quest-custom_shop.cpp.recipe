+// Jep (co-op, coop-pt1111e): the open shop as data (custom_shop.hpp).
+namespace {
+void PutInt(std::string &out, std::int64_t value) {
+    for (int i = 0; i < 8; i++) {
+        out.push_back(static_cast<char>(static_cast<std::uint64_t>(value) >> (8 * i)));
+    }
+}
+void PutText(std::string &out, const std::string &text) {
+    PutInt(out, static_cast<std::int64_t>(text.size()));
+    out += text;
+}
+struct Cursor {
+    std::string_view data;
+    std::size_t      at = 0;
+    bool             ok = true;
+    std::int64_t     Int() {
+        if (at + 8 > data.size()) {
+            ok = false;
+            return 0;
+        }
+        std::uint64_t value = 0;
+        for (int i = 0; i < 8; i++) {
+            value |= static_cast<std::uint64_t>(static_cast<unsigned char>(data[at + i])) << (8 * i);
+        }
+        at += 8;
+        return static_cast<std::int64_t>(value);
+    }
+    std::string Text() {
+        const std::int64_t size = Int();
+        if (!ok || size < 0 || at + static_cast<std::size_t>(size) > data.size()) {
+            ok = false;
+            return {};
+        }
+        std::string text(data.substr(at, static_cast<std::size_t>(size)));
+        at += static_cast<std::size_t>(size);
+        return text;
+    }
+};
+} // namespace
+
+void CustomShopWrite(std::string &out) {
+    if (!g_open) {
+        return;
+    }
+    const Open &open = *g_open;
+    PutInt(out, open.shop.look);
+    PutInt(out, static_cast<std::int64_t>(open.shop.goods.size()));
+    for (const auto &[item, price] : open.shop.goods) {
+        PutInt(out, item);
+        PutInt(out, price);
+    }
+    PutText(out, open.shop.keeper);
+    PutInt(out, static_cast<std::int64_t>(open.shop.lines.size()));
+    for (const auto &[line, text] : open.shop.lines) {
+        PutInt(out, static_cast<std::int64_t>(line));
+        PutText(out, text);
+    }
+    for (const s16 good : open.goods) {
+        PutInt(out, good);
+    }
+    PutInt(out, static_cast<std::int64_t>(open.prices.size()));
+    for (const auto &[item, price] : open.prices) {
+        PutInt(out, item);
+        PutInt(out, price);
+    }
+    PutText(out, open.keeper_image);
+}

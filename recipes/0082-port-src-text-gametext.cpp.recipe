+namespace dc::game {
+
+// Jep (co-op), coop: netplay: a resync (TakeState) starts the town's message windows over on both copies, so a window one
+// copy made before the join and the other never did is rebuilt on both alike.
+void PortMessageCachesReset() {
+    for (ClsMes *message : {&EditMes1, &EditEventMes1, &EditNameMes, &EditSystemMes, &EditMes2, &EditEventMes2, &EditHelpMes}) {
+        message->mes_made = -1;
+    }
+}
+
+} // namespace dc::game

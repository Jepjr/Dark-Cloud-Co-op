+// Jep (co-op, coop-p2hurt2): the pulse's state exchanged with a body's own, so another player's body runs this same pulse
+// (setUnitAmbientAnime, unitAmbientAnime) on its own state, and the tests read the player's (coop_party.cpp, PulseRun).
+void UnitAmbientAnimeExchange(float *rgb, float *count, float *speed, s32 *timer, s32 *flag) {
+    for (int i = 0; i < 3; i++) {
+        std::swap(unitAmbientAnime_rgb[i], rgb[i]);
+    }
+    std::swap(unitAmbientAnime_Count, *count);
+    std::swap(unitAmbientAnime_Speed, *speed);
+    std::swap(unitAmbientAnime_Timer, *timer);
+    std::swap(unitAmbientAnime_flag, *flag);
+}

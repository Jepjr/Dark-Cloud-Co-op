+
+    DrawMenu2DSprite(faces, screen, CRect_i_(u, v, 0x30, 0x30), shade, shade, shade, alpha);
+    if (QuickRingTrace()) {
+        std::fprintf(stderr, "quick ring: face %d at %d,%d size %d texel %d,%d shade %d alpha %d\n", chara, (int) screen.x, (int) screen.y,
+                     (int) screen.width, u, v, shade, alpha);
+    }
+}

+void QuickRingPoint(int slot, int count, float radius, float turn_frames, float direction, float *x, float *y) {
+    const float step = TWO_PI / count;
+    float       turn = step / 20.0f;
+
+    if (direction < 0.0f) {
+        turn = -turn;
+    }
+
+    const float angle = PI + (step * slot + turn * turn_frames);
+    *x = radius * cos(angle);
+    *y = radius * sin(angle);
+}
+
+void QuickRingFace(CTexture *faces, int chara, float x, float y, int shade, int alpha) {

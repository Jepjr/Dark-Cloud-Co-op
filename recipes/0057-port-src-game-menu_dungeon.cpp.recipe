+// The ring's first choice: the weapon's own element (none for an element out of the stones' range).
+int ElementChoiceOfCurrent(const s8 *choices, int count, int current) {
+    int selected = 0;
+
+    for (int i = 0; i < count; i++) {
+        if (choices[i] == current || (choices[i] == WEAPON_ELEMENT_NONE && (current < 0 || current > 4))) {
+            selected = i;
+        }
+    }
+
+    return selected;
+}

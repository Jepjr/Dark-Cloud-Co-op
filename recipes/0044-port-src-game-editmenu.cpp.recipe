+// Jep (co-op), coop-soakfix4 (a test hook, netplay.cpp): the town edit menu's page and cursor for a test's presses, read and set
+// from outside (EditSwitch and EdCur are this file's own since Chronicle 9418a550).
+int EditMenuPage() {
+    return static_cast<int>(EditSwitch);
+}
+
+bool EditMenuOnSelect() {
+    return EditSwitch == EditMenuState::Select;
+}
+
+bool EditMenuOnOption() {
+    return EditSwitch == EditMenuState::OptionIn || EditSwitch == EditMenuState::Option;
+}
+
+int EditMenuCursor() {
+    return EdCur.selection;
+}
+
+void EditMenuSetCursor(int selection) {
+    EdCur.selection = static_cast<s8>(selection);
+}
+

+} // namespace
+
+void DialogNpcSetCoopHooks(DialogNpcPickFn pick, DialogNpcWithOwnFn with_own, DialogNpcOwnsFn owns) {
+    g_pick_hook = pick;
+    g_own_hook = with_own;
+    g_owns_hook = owns;
+}
+
+void DialogNpcHoverDraw(ClsMes *mes, bool begin) {
+    if (g_pick_hook == nullptr || mes != &EditMes1) {
+        return;
+    }
+    if (!begin) {
+        if (g_hover_saved != -2) {
+            EditMes1.cursor_row = g_hover_saved;
+            g_hover_saved = -2;
+        }
+        return;
+    }
+    if (g_hover < 0 || g_window.choice_rows <= 0 || g_hover >= g_window.choice_rows || !IsSessionActive() || g_window.retail_buff == nullptr ||
+        (g_owns_hook != nullptr && !g_owns_hook())) {
+        return;
+    }
+    g_hover_saved = EditMes1.cursor_row;
+    EditMes1.cursor_row = g_window.first_row + g_hover; // (this screen's hand alone: put back as the draw ends)
+}
+
+void DialogNpcTestPointer(int choice, bool click) {
+    struct Ctx {
+        int  choice;
+        bool click;
+    } ctx{choice, click};
+    WithOwn(
+        [](void *p) {
+            const auto *c = static_cast<const Ctx *>(p);
+            if (g_window.retail_buff != nullptr && IsSessionActive()) {
+                PointerAct(c->choice < g_window.choice_rows ? c->choice : -1, true, c->click ? 1 : 0, 0.0f);
+            }
+        },
+        &ctx);
+}

+
+// fn with the viewer's own conversation open (the co-op hook swaps its talker's in and back), else the open one.
+void WithOwn(void (*fn)(void *), void *ctx) {
+    if (g_own_hook == nullptr || !g_own_hook(fn, ctx)) {
+        fn(ctx);
+    }

+// Jep (co-op, coop-pt1111e): each talker's window, kept and carried beside its session (npc.hpp).
=20 928f49b1ad17d82d
+
+namespace {
+
+struct KeptWindow {
+    short       *retail_buff = nullptr;
+    std::string  shown;
=37 ec0c99ee0f907540
+    int          first_row = 0;
+    int          choice_rows = 0;
+};
+
+std::array<KeptWindow, kSessionSlots> g_kept_windows;
+
+void SwapWindow(KeptWindow &kept) {
+    std::swap(kept.retail_buff, g_window.retail_buff);
+    std::swap(kept.shown, g_window.shown);
+    std::swap(kept.file, g_window.file);
+    std::swap(kept.first_row, g_window.first_row);
+    std::swap(kept.choice_rows, g_window.choice_rows);
+}
+
+void PutU64(std::string &out, std::uint64_t value) {
+    for (int i = 0; i < 8; i++) {
+        out.push_back(static_cast<char>(value >> (8 * i)));
+    }
+}
+
+void PutStr(std::string &out, const std::string &text) {
+    PutU64(out, text.size());
+    out += text;
+}
+
+bool GetU64(const char *data, std::size_t size, std::size_t &at, std::uint64_t &value) {
+    if (at + 8 > size) {
+        return false;
+    }
+    value = 0;
+    for (int i = 0; i < 8; i++) {
+        value |= static_cast<std::uint64_t>(static_cast<unsigned char>(data[at + i])) << (8 * i);
+    }
+    at += 8;
+    return true;
+}
+
+bool GetStr(const char *data, std::size_t size, std::size_t &at, std::string &text) {
+    std::uint64_t length = 0;
+    if (!GetU64(data, size, at, length) || at + length > size) {
+        return false;
+    }
+    text.assign(data + at, length);
+    at += length;
+    return true;
+}
+
+void PutWindow(std::string &out, const short *retail_buff, const std::string &shown, int first_row, int choice_rows) {
+    PutU64(out, reinterpret_cast<std::uintptr_t>(retail_buff)); // (the villagers' message file: the game's, at one address on every copy)
+    PutStr(out, shown);
+    PutU64(out, static_cast<std::uint32_t>(first_row));
+    PutU64(out, static_cast<std::uint32_t>(choice_rows));
+}
+
+bool GetWindow(const char *data, std::size_t size, std::size_t &at, KeptWindow &window) {
+    std::uint64_t buff = 0, first = 0, rows = 0;
+    std::string   shown;
+    if (!GetU64(data, size, at, buff) || !GetStr(data, size, at, shown) || !GetU64(data, size, at, first) || !GetU64(data, size, at, rows)) {
+        return false;
+    }
+    window.retail_buff = reinterpret_cast<short *>(static_cast<std::uintptr_t>(buff));
+    window.shown = std::move(shown);
+    window.first_row = static_cast<int>(static_cast<std::uint32_t>(first));
+    window.choice_rows = static_cast<int>(static_cast<std::uint32_t>(rows));
+    window.file = GameTextFile{};
+    if (!window.shown.empty()) {
+        window.file.Set(0, window.shown); // (this copy's own text for EditMes1, as ShowWindow made it on the other)
+    }
+    return true;
+}
+
+} // namespace
+
+void DialogNpcRepoint() {
+    if (g_window.retail_buff != nullptr && !g_window.shown.empty() && IsSessionActive()) {
=156 355ce066dc8a1b27
+    }
+}
+
+void DialogNpcSwapWindow(int slot) {
+    if (slot < 0 || slot >= kSessionSlots) {
+        return;
+    }
+    SwapWindow(g_kept_windows[static_cast<std::size_t>(slot)]);
+}
+
+void DialogNpcWriteWindows(std::string &out) {
+    PutWindow(out, g_window.retail_buff, g_window.shown, g_window.first_row, g_window.choice_rows);
+    for (const KeptWindow &kept : g_kept_windows) {
+        PutWindow(out, kept.retail_buff, kept.shown, kept.first_row, kept.choice_rows);
+    }
+}
+
+bool DialogNpcReadWindows(const char *data, std::size_t size) {
+    std::size_t                           at = 0;
+    KeptWindow                            live;
+    std::array<KeptWindow, kSessionSlots> kept;
+    bool                                  ok = GetWindow(data, size, at, live);
+    for (KeptWindow &window : kept) {
+        ok = ok && GetWindow(data, size, at, window);
+    }
+    if (!ok) {
+        return false;
+    }
+    SwapWindow(live);
+    g_kept_windows = std::move(kept);
+    ClsMesSetChoiceRows(nullptr, 0); // (set again by the window's next ShowWindow, as the other copy's)
+    DialogNpcRepoint();
+    return true;
+}
